# Editing Basics - File > New Scene, then type a spinning triangle ringed
# by a torus, committing each line with `;` - the same keystrokes a user
# would make.
#
# Points are symbolic targets (grammar: src/app/glr_pointer_script.h).

move scene:0.55,0.30
echo scene:0.25,0.76 24 3.0 Let's build a scene from scratch.
glide menu:file 0.8          # the File menu
click
glide item:new_scene 0.5     # New Scene row
click
echo scene:0.25,0.76 24 3.4 A new scene seeds the GL boilerplate.
pause 3.4
echo scene:0.25,0.76 24 3.4 Type a command; the ; key commits it.
key@20 glRotatef(t * 40, 0, 1, 0)
key ;
echo scene:0.25,0.76 24 3.0 t is the animation clock (Ctrl+T).
key@20 glBegin(GL_TRIANGLES)
key ;
key@20 glColor3f(1, 0.42, 0.3)
key ;
key@20 glVertex3f(-1, -0.7, 0)
key ;
key@20 glColor3f(0.35, 0.85, 0.55)
key ;
key@20 glVertex3f(1, -0.7, 0)
key ;
key@20 glColor3f(0.45, 0.6, 1)
key ;
key@20 glVertex3f(0, 1.1, 0)
key ;
key@20 glEnd()
key ;
echo scene:0.25,0.76 24 3.6 The gray ghost is autocomplete (Tab).
key@20 glutSolidT
pause 1.6                       # let the autocomplete ghost linger
key@20 orus(0.25, 1.4, 16, 32)
key ;
echo scene:0.25,0.76 24 4.0 Lines re-run every frame. Undo: Ctrl+Z.
pause 4.0
echo scene:0.25,0.76 24 3.6 Tour finished - it's all yours!
