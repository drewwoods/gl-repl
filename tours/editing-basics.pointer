# Editing Basics - File > New Scene, then type a spinning triangle ringed
# by a torus, committing each line with `;` - the same keystrokes a user
# would make.
#
# Points are symbolic targets (grammar: src/app/glr_pointer_script.h).

move scene:0.55,0.30
echo bitmap scene:0.25,0.76 24 3.0 Let's build a scene from scratch.
#ifdef __EMSCRIPTEN__
glide shell:new 0.8             # browser shell's New button
click shell:new
glide scene:0.55,0.30 0.6       # bring the tour cursor back into the canvas
#else
glide menu:file 0.8          # the File menu
click
glide item:new_scene 0.5     # New Scene row
click
#endif

# recenter camera
chord ctrl+shift c

echo bitmap scene:0.20,0.20 24 3.4 A new scene seeds the GL boilerplate.
glide code:3 0.2
ring  code:1 0.3
ring  code:2 0.3
ring  code:3 0.3
ring  code:4 0.3
ring  code:5 0.3
ring  code:6 0.3

# @checkpoint after-new-scene
echo bitmap scene:0.15,0.20 24 3.4 Type a command; the ; key commits it.

# ctrl+j - enter
key \cj
key@20 // Let's create a rotating triangle surrounded by a torus
key ;

key@10 glRotatef(
pause 0.2
key@5 t * 40, 0, 1, 0);
echo bitmap scene:0.20,0.20 18 8.0 The cursor position also triggers overlays, with the cursor on the\n glRotatef line the effect on the geomtry is revealed in the scene
skey up
glide code:9 0.5
ring code:9 1.5
glide scene:0.5,0.5 1.0
ring scene:0.5,0.5 1.5
pause 3.0

skey down
key@10 glBegin(GL_TRIANGLES)
key ;

# @checkpoint before-geometry
key@10 glColor3f(1, 0.4, 0.4)
key ;

echo bitmap scene:0.20,0.20 18 4.0 Overlays also act as a guide as the vertex is specified\n-
key@10 glVertex3f(-1,
echo bitmap scene:0.20,0.20 18 4.0 Overlays also act as a guide as the vertex is specified\n- 2 DOF produces the plane x = - 1)
ring scene:0.5,0.5 2.0
pause 2.0
key@10 -0.7,
echo bitmap scene:0.20,0.20 18 4.0 Overlays also act as a guide as the vertex is specified\n- 1 DOF produces the line x = - 1, y = -0.7)
pause 4.0
key@10 0)
echo bitmap scene:0.20,0.20 18 4.0 Overlays also act as a guide as the vertex is specified\n- 0 DOF produces the point (-1, 0.7, 0)
pause 5.0
key@10 ;

echo bitmap scene:0.20,0.20 18 4.0 Let's finish the other two points of the triangle
key@20 glColor3f(0.4, 1, 0.4);
key ;
key@20 glVertex3f(1, -0.7, 0)
key ;
key@20 glColor3f(0.4, 0.4, 1)
key ;
key@20 glVertex3f(0, 1.1, 0)
key ;
key@20 glEnd()
key ;
echo bitmap scene:0.20,0.20 18 4.0 There a beautiful triangle
pause 4.0

echo bitmap scene:0.20,0.20 18 3.6 The gray ghost is autocomplete (Tab).
# @checkpoint before-torus
key \cj
key@20 glutSolidT
pause 2.6                       # let the autocomplete ghost linger
key@20 orus(0.25, 1.4, 16, 32)
key ;
skey up

echo bitmap scene:0.20,0.20 18 5.6 The torus picks up the last glColor, as shown in the gutter
glide code:15 1.0
ring code:15 1.0
echo bitmap scene:0.20,0.20 18 5.6 You can also see the transformations affecting it
glide code:9 1.0
ring code:9 1.0

echo bitmap scene:0.20,0.76 18 5.6 You can also see the gl state at a point (rightclick)
glide code:18 1.0
rightclick
pause 4.0

echo bitmap scene:0.20,0.76 18 5.6 And compare current GL state to a previous point (shitf + rightclick)
glide code:7 1.0
rightclick shift

pause 4.0
echo bitmap scene:0.25,0.76 24 3.6 Tour finished - it's all yours!
