# Editing Basics - File > New Scene, then type a spinning triangle ringed
# by a torus, committing each line with `;` - the same keystrokes a user
# would make.
#
# Points are symbolic targets (grammar: src/app/glr_pointer_script.h).

move scene:0.55,0.30
echo bitmap scene:0.25,0.76 24 3.0 Let's build a scene from scratch.
#ifdef __EMSCRIPTEN__
glide shell:new 0.8             # browser shell's New button
click shell:new
glide scene:0.55,0.30 0.6       # bring the tour cursor back into the canvas
#else
glide menu:file 0.8          # the File menu
click
glide item:new_scene 0.5     # New Scene row
click
#endif
echo bitmap scene:0.25,0.76 24 3.4 A new scene seeds the GL boilerplate.
# @checkpoint after-new-scene
ring code:1 0.5
ring code:2 0.5
ring code:3 0.5
ring code:4 0.5
ring code:5 0.5
ring code:6 0.5

echo bitmap scene:0.25,0.76 24 3.4 Type a command; the ; key commits it.
# @checkpoint before-geometry

# ctrl+j - enter
key \cj
key@20 // Let's create a rotating triangle surrounded by a torus
key ;
key@10 glRotatef(
pause 0.2
key@5 t * 40, 0, 1, 0)
pause 1.0
echo mono code:3 24 3.0 Note how we can see the effect for transformation in real time
key ;
echo bitmap scene:0.25,0.76 24 3.0 t is the animation clock (Ctrl+T).
key@10 glBegin(GL_TRIANGLES)
key ;
key@10 glColor3f(1, 0.42, 0.3)
key ;
key@10 glVertex3f(-1,
pause 0.5
key@10 -0.7,
pause 0.5
key@10 0)
pause 0.5
key@10 ;
key@20 glColor3f(0.35, 0.85, 0.55)
key ;
key@20 glVertex3f(1, -0.7, 0)
key ;
key@20 glColor3f(0.45, 0.6, 1)
key ;
key@20 glVertex3f(0, 1.1, 0)
key ;
key@20 glEnd()
key ;
echo bitmap scene:0.25,0.76 24 3.6 The gray ghost is autocomplete (Tab).
# @checkpoint before-torus
key@20 glutSolidT
pause 1.6                       # let the autocomplete ghost linger
key@20 orus(0.25, 1.4, 16, 32)
key ;
echo bitmap scene:0.25,0.76 24 4.0 Lines re-run every frame. Undo: Ctrl+Z.
pause 4.0
echo bitmap scene:0.25,0.76 24 3.6 Tour finished - it's all yours!
