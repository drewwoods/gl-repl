# Camera & Views - orbit drags in the scene (scripted press + glide routes
# through the real drag handlers), wheel zoom, and the focus-origin ease.
#
# Points are symbolic targets (grammar: src/app/glr_pointer_script.h).

move scene:0.58,0.30
echo scene:0.25,0.76 18 3.2 Drag anywhere in the scene to orbit.
down scene:0.58,0.30
glide scene:0.80,0.12 1.6
up
pause 0.5
down
glide scene:0.50,0.42 1.2
up
pause 0.5
echo scene:0.25,0.76 18 2.8 The mouse wheel zooms.
wheel 1
pause 0.4
wheel 1
pause 0.4
wheel 1
pause 0.4
wheel 1
pause 0.9
wheel -1
pause 0.4
wheel -1
pause 0.4
wheel -1
pause 0.4
wheel -1
pause 0.7
echo scene:0.25,0.76 18 3.4 Ctrl+O focuses the origin.
key \co
pause 2.8
echo scene:0.25,0.76 18 3.6 Ctrl+Shift+C resets the camera.
chord ctrl+shift c
pause 3.6
echo scene:0.25,0.76 18 3.6 Tour finished - it's all yours!
