# Camera & Views - orbit drags in the scene (scripted press + glide routes
# through the real drag handlers), wheel zoom, and the focus-origin ease.
#
# Points are symbolic targets (grammar: src/app/glr_pointer_script.h).

view 3d
move scene:0.58,0.30
echo bitmap scene:0.25,0.76 24 3.2 Drag anywhere in the scene to orbit.
down scene:0.58,0.30
glide scene:0.80,0.35 1.6
up
pause 0.5
down
glide scene:0.50,0.42 1.2
up
pause 0.5
echo bitmap scene:0.25,0.76 24 3.0 Right-click and drag to pan across the ground plane.
rightdown scene:0.58,0.30
glide scene:0.72,0.42 1.4
rightup
pause 0.6
rightdown
glide scene:0.50,0.30 1.2
rightup
pause 0.5
echo bitmap scene:0.25,0.76 24 3.0 Shift+right-click and drag to pan up and down.
rightdown shift scene:0.58,0.34
glide scene:0.58,0.18 1.2
rightup
pause 0.5
rightdown shift
glide scene:0.58,0.34 1.0
rightup
pause 0.5
echo bitmap scene:0.25,0.76 24 2.8 The mouse wheel zooms.
wheel 20
pause 0.9
wheel -20
pause 0.7
echo bitmap scene:0.25,0.76 24 3.4 Ctrl+O focuses the origin.
key \co
pause 2.8
echo bitmap scene:0.25,0.76 24 3.6 Ctrl+Shift+C resets the camera.
chord ctrl+shift c
pause 3.6
echo bitmap scene:0.25,0.76 24 3.6 Tour finished - it's all yours!
