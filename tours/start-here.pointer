# Menus & Examples - menu walk mirroring scripts/video/menu-tour.pointer:
# browse the Scene example flyouts, load the Sierpinski sponge, peek at
# Tutorials, toggle a Config overlay (and toggle it back), then run Replay
# on the result.
#
# Points are symbolic targets (grammar: src/app/glr_pointer_script.h),
# resolved against the live layout at fire time. The caption band anchors
# at scene:0.25,0.76: inside the scene viewport, above the replay HUD /
# status bar, and (at <= 40 caption chars) clear of the variable panel's
# right-hand column.

move scene:0.55,0.30
echo bitmap scene:0.25,0.76 24 3.2 Welcome! This tour drives gl-repl.
pause 2.5
echo bitmap scene:0.25,0.76 24 2.8 Press any key or click to stop it.
pause 2.5
echo bitmap scene:0.25,0.76 24 3.6 The Scene menu holds the examples.
glide menu:scene 0.9         # up to the Scene menu
click
glide item:all 0.7           # hover All (every example, grouped)
glide item:3d 0.6            # hover 3D -> examples flyout opens
glide subenter:3d 0.5        # straight right into the flyout
echo bitmap scene:0.25,0.76 24 3.2 Hover a tag; slide into its flyout.
glide sub:3d:animated_ring 0.5   # hover highlight follows
glide sub:3d:torus_knot 0.7
ring sub:3d:torus_knot 1.2       # spotlight it
glide sub:3d:sierpinski_sponge 1.1   # down to the recursion showcase
echo bitmap scene:0.25,0.76 24 2.6 Click loads the example.
click                        # load it; camera eases in
pause 3.5
echo bitmap scene:0.25,0.76 24 3.4 Tutorials teach step by step.
glide menu:tutorials 1.0
click
glide item:geometry 0.7      # hover Geometry -> tutorial flyout
glide subenter:geometry 0.4
glide sub:geometry:first_triangle 0.5
ring sub:geometry:first_triangle 1.6   # spotlight, don't start it
echo bitmap scene:0.25,0.76 24 3.6 Config: grids, themes, overlays.
glide menu:config 0.8
click
glide item:rendering 0.6     # hover Rendering
glide item:overlays 0.7      # walk down to Overlays
glide subenter:overlays 0.4
glide sub:overlays:vertex_outlines 0.5
ring sub:overlays:vertex_outlines 1.2
click                        # Vertex outlines ON (sponge faces outlined)
echo bitmap scene:0.25,0.76 24 2.8 Toggles apply live, for example vertex outlines.
pause 2.8
echo bitmap scene:0.25,0.76 24 2.8 Turning vertex outlines back OFF again.
ring sub:overlays:vertex_outlines 1.2
click                        # ...and back OFF
pause 0.25
click scene:0.55,0.30        # dismiss the menu
echo bitmap scene:0.25,0.76 24 3.2 Replay rebuilds the scene call by call.
glide pin:replay 1.2
click                        # start replay
glide scene:0.70,0.40 1.0    # park; watch it build
pause 5.0                    # let replay build the scene
# Ctrl+R exits the replay (the pin click would only pause it)
echo bitmap scene:0.25,0.76 18 3.6 Tour finished - it's all yours!\nWatch the replay finish, or press Escape to take control now.\nThen move the camera and explore the scene.
