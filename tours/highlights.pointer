# Highlights - the short showcase used for the README animation. Three
# acts, roughly 45 seconds: type a 2D triangle and give it a transform
# (learn), replay the parametric torus call by call (debug), then load
# the jellyfish and let it run (build).
#
# Points are symbolic targets (grammar: src/app/glr_pointer_script.h),
# resolved against the live layout at fire time, so the tour plays at any
# window size. The caption band anchors at scene:0.25,0.76 - inside the
# scene viewport, above the status bar, and clear of the variable panel's
# right-hand column.

#reset presentation             # a known screen, whatever the last tour left

move scene:0.55,0.30
echo stroke_hi scene:0.5,0.76 32 2.6 GL-REPL: Render as you type

# --- Learn: a 2D triangle, typed line by line ------------------------

#ifdef __EMSCRIPTEN__
glide shell:new 0.5             # browser shell's New button
click shell:new
glide scene:0.55,0.30 0.3       # bring the tour cursor back into the canvas
#else
glide menu:file 0.5             # File > New Scene
click
glide item:new_scene 0.3
click
#endif
chord ctrl+shift c              # recenter the camera
view 2d                         # flat view - this act is a 2D sketch

cfg grid GRID_THEME_OFF

# @checkpoint after-new-scene

echo bitmap scene:0.25,0.76 24 3.4 See the impact of transformations live
key@30 glRotatef(t * 20, 0, 0, 1)
# The ; key commits the line. `key` payload runs to end of line, so these
# lines carry no trailing comment - it would be typed into the editor.
pause 2.6
key ;

# @checkpoint before-triangle

echo bitmap scene:0.25,0.76 24 5.6 Watch each vertex appear as it is defined
key@40 glBegin(GL_TRIANGLES);
key@40 glColor3f(1, 0, 0);
key@30 glVertex2f(
key@5 -1, -0.7);
key@40 glColor3f(1, 1, 1);
key@40 glVertex2f(1, -0.7);
key@40 glVertex2f(0, 1.1);
key@40 glEnd();

# --- Debug: replay a built-in example, call by call ------------------

# @checkpoint before-torus

glide menu:scene 0.7
click
glide item:3d 0.4               # hover 3D -> examples flyout opens
glide subenter:3d 0.3           # straight right into the flyout
glide sub:3d:parametric_torus 0.5
click                           # load it; camera eases in
cfg vertex_points 0

# @checkpoint before-replay
echo bitmap scene:0.25,0.76 24 5.6 Replay is a visual debugger. Code and scene advance one vertex at a time
glide pin:replay 0.7
click                           # start replay
key v
glide code:30 0.7
ring code:30 1.0
pause 1.0
glide scene:0.72,0.34 0.6       # park; watch it build
ring scene:0.72,0.34 1.0
pause 2.0

# --- Build: the same language, a finished scene ----------------------

# @checkpoint before-jellyfish

glide menu:scene 0.4
click
glide item:3D 0.2            # hover 3D -> flyout opens
glide subenter:3D 0.2
glide sub:3D:jellyfish 0.35
pause 0.25
click
# Ctrl+R exits the replay (the pin click would only pause it)
key \cr
echo bitmap scene:0.25,0.76 24 3.6 Create beautiful scenes
pause 3.0
echo bitmap scene:0.25,0.76 18 3.0 Tour finished - it's all yours!\nEscape takes control now.
