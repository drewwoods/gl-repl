Serve glGet* of tracked-but-unmirrored state client-side instead of
round-tripping to the GLES driver.

gl4es answers most glGet* queries from its own state, but a handful of
pnames fell through the getter switches to the real driver:
GL_COLOR_CLEAR_VALUE, GL_DEPTH_CLEAR_VALUE, GL_LINE_WIDTH,
GL_SCISSOR_BOX, GL_VIEWPORT and GL_GENERATE_MIPMAP_HINT. On WebGL a
driver glGet* becomes gl.getParameter(), which is synchronous: the
browser drains every queued GPU command before answering. gl4es's own
glPushAttrib reads several of these (GL_COLOR_BUFFER_BIT reads the
clear color; GL_VIEWPORT_BIT the viewport; GL_LINE_BIT the line width;
GL_SCISSOR_BIT the scissor box), and bitmap_flush's blit pushes
GL_COLOR_BUFFER_BIT before every glyph-batch draw -- so each run of
glutBitmapString text after other geometry stalled the pipeline.

Mirror the missing values client-side. Clear color / line width /
generate-mipmap hint are captured in their setters; GL_DEPTH_CLEAR_VALUE
is served from glstate->depth.clear (the live setter is depth.c —
wrap/gles.c's glClearDepthf is skip_glClearDepthf and never runs).
Viewport and scissor use tracked state once glViewport/glScissor has
run (or an init query filled them), including a legal zero-size box —
width==0 is not a "never set" sentinel. Scalar pnames go through
gl4es_commonGet so glGetIntegerv/glGetFloatv/glGetDoublev agree;
4-component pnames are answered in all three typed getters.

Applied by scripts/web-deps.sh after the bitmap-dirty-clear patch.

diff --git a/src/gl/depth.c b/src/gl/depth.c
index 84298216..b741fef2 100644
--- a/src/gl/depth.c
+++ b/src/gl/depth.c
@@ -60,6 +60,10 @@ void APIENTRY_GL4ES gl4es_glClearDepthf(GLclampf depth) {
     }
     noerrorShim();
     glstate->depth.clear = depth;
+    {
+        extern GLfloat gl4es_mirror_clear_depth;
+        gl4es_mirror_clear_depth = depth;
+    }
     LOAD_GLES(glClearDepthf);
     errorGL();
     gles_glClearDepthf(depth);
diff --git a/src/gl/getter.c b/src/gl/getter.c
index 3a9acc55..9edc08c0 100644
--- a/src/gl/getter.c
+++ b/src/gl/getter.c
@@ -16,6 +16,19 @@
 #define DBG(a)
 #endif
 
+/* Client-side mirrors for pnames whose glGet* otherwise falls through to the
+ * GLES driver. On WebGL a driver glGet* is a synchronous getParameter() that
+ * drains the queued GPU pipeline before returning -- glPushAttrib paths that
+ * read these (GL_COLOR_BUFFER_BIT -> GL_COLOR_CLEAR_VALUE, etc.) turn every
+ * push into a multi-millisecond stall mid-frame. Written by the matching
+ * state setters (glClearColor / glLineWidth / glHint). GL_DEPTH_CLEAR_VALUE
+ * is served from glstate->depth.clear (depth.c); wrap/gles.c's ClearDepthf
+ * is skip_glClearDepthf and never runs. */
+GLfloat gl4es_mirror_clear_color[4] = {0.f, 0.f, 0.f, 0.f};
+GLfloat gl4es_mirror_clear_depth = 1.0f; /* written from depth.c; getter reads glstate->depth.clear */
+GLfloat gl4es_mirror_line_width = 1.0f;
+GLint   gl4es_mirror_mipmap_hint = GL_DONT_CARE;
+
 GLenum APIENTRY_GL4ES gl4es_glGetError(void) {
     DBG(printf("glGetError(), noerror=%d, type_error=%d shim_error=%s\n", globals4es.noerror, glstate->type_error, PrintEnum(glstate->shim_error));)
     if(globals4es.noerror)
@@ -284,6 +297,26 @@ AliasExport(const GLubyte*,glGetString,,(GLenum name));
 
 #define TOP(A) (glstate->A->stack+(glstate->A->top*16))
 
+static int getter_viewport4(GLfloat *params) {
+    if (!glstate->raster.viewport_known)
+        return 0;
+    params[0] = (GLfloat)glstate->raster.viewport.x;
+    params[1] = (GLfloat)glstate->raster.viewport.y;
+    params[2] = (GLfloat)glstate->raster.viewport.width;
+    params[3] = (GLfloat)glstate->raster.viewport.height;
+    return 1;
+}
+
+static int getter_scissor4(GLfloat *params) {
+    if (!glstate->raster.scissor_known)
+        return 0;
+    params[0] = (GLfloat)glstate->raster.scissor.x;
+    params[1] = (GLfloat)glstate->raster.scissor.y;
+    params[2] = (GLfloat)glstate->raster.scissor.width;
+    params[3] = (GLfloat)glstate->raster.scissor.height;
+    return 1;
+}
+
 int gl4es_commonGet(GLenum pname, GLfloat *params) {
     switch (pname) {
         case GL_MAJOR_VERSION:
@@ -308,6 +341,15 @@ int gl4es_commonGet(GLenum pname, GLfloat *params) {
         case GL_AUX_BUFFERS:
             *params = 0;
             break;
+        case GL_DEPTH_CLEAR_VALUE:
+            *params = glstate->depth.clear;
+            break;
+        case GL_LINE_WIDTH:
+            *params = gl4es_mirror_line_width;
+            break;
+        case GL_GENERATE_MIPMAP_HINT:
+            *params = (GLfloat)gl4es_mirror_mipmap_hint;
+            break;
         case GL_MAX_TEXTURE_UNITS:
             *params = hardext.maxtex;
             break;
@@ -878,6 +920,36 @@ void APIENTRY_GL4ES gl4es_glGetIntegerv(GLenum pname, GLint *params) {
             params[0] = glstate->depth.Near*2147483647l;
             params[1] = glstate->depth.Far*2147483647l;
             break;
+        case GL_VIEWPORT: {
+            GLfloat v[4];
+            if (getter_viewport4(v)) {
+                params[0] = (GLint)v[0];
+                params[1] = (GLint)v[1];
+                params[2] = (GLint)v[2];
+                params[3] = (GLint)v[3];
+            } else {
+                gles_glGetIntegerv(GL_VIEWPORT, params);
+            }
+            break;
+        }
+        case GL_SCISSOR_BOX: {
+            GLfloat v[4];
+            if (getter_scissor4(v)) {
+                params[0] = (GLint)v[0];
+                params[1] = (GLint)v[1];
+                params[2] = (GLint)v[2];
+                params[3] = (GLint)v[3];
+            } else {
+                gles_glGetIntegerv(GL_SCISSOR_BOX, params);
+            }
+            break;
+        }
+        case GL_COLOR_CLEAR_VALUE:
+            params[0] = (GLint)gl4es_mirror_clear_color[0];
+            params[1] = (GLint)gl4es_mirror_clear_color[1];
+            params[2] = (GLint)gl4es_mirror_clear_color[2];
+            params[3] = (GLint)gl4es_mirror_clear_color[3];
+            break;
         default:
             errorGL();
             gles_glGetIntegerv(pname, params);
@@ -945,6 +1017,17 @@ void APIENTRY_GL4ES gl4es_glGetFloatv(GLenum pname, GLfloat *params) {
             params[0] = glstate->depth.Near;
             params[1] = glstate->depth.Far;
             break;
+        case GL_COLOR_CLEAR_VALUE:
+            memcpy(params, gl4es_mirror_clear_color, 4*sizeof(GLfloat));
+            break;
+        case GL_VIEWPORT:
+            if (!getter_viewport4(params))
+                gles_glGetFloatv(GL_VIEWPORT, params);
+            break;
+        case GL_SCISSOR_BOX:
+            if (!getter_scissor4(params))
+                gles_glGetFloatv(GL_SCISSOR_BOX, params);
+            break;
         default:
             errorGL();
             gles_glGetFloatv(pname, params);
@@ -1027,6 +1110,26 @@ void APIENTRY_GL4ES gl4es_glGetDoublev(GLenum pname, GLdouble *params) {
             params[0] = glstate->depth.Near;
             params[1] = glstate->depth.Far;
             break;
+        case GL_COLOR_CLEAR_VALUE:
+            memcpy(tmp, gl4es_mirror_clear_color, 4*sizeof(GLfloat));
+            for (int i=0; i<4; i++) params[i] = tmp[i];
+            break;
+        case GL_VIEWPORT:
+            if (getter_viewport4(tmp)) {
+                for (int i=0; i<4; i++) params[i] = tmp[i];
+            } else {
+                gles_glGetFloatv(GL_VIEWPORT, tmp);
+                for (int i=0; i<4; i++) params[i] = tmp[i];
+            }
+            break;
+        case GL_SCISSOR_BOX:
+            if (getter_scissor4(tmp)) {
+                for (int i=0; i<4; i++) params[i] = tmp[i];
+            } else {
+                gles_glGetFloatv(GL_SCISSOR_BOX, tmp);
+                for (int i=0; i<4; i++) params[i] = tmp[i];
+            }
+            break;
         default:
             errorGL();
             gles_glGetFloatv(pname, tmp);
diff --git a/src/gl/glstate.c b/src/gl/glstate.c
index 11929120..16b29bd8 100644
--- a/src/gl/glstate.c
+++ b/src/gl/glstate.c
@@ -391,6 +391,8 @@ void* NewGLState(void* shared_glstate, int es2only) {
     LOAD_GLES(glGetIntegerv);
     gles_glGetIntegerv(GL_VIEWPORT, (GLint*)&glstate->raster.viewport);
     gles_glGetIntegerv(GL_SCISSOR_BOX, (GLint*)&glstate->raster.scissor);
+    glstate->raster.viewport_known = 1;
+    glstate->raster.scissor_known = 1;
 #if defined(AMIGAOS4) || defined(__EMSCRIPTEN__)
     }
 #endif
@@ -615,6 +617,8 @@ void ActivateGLState(void* new_glstate) {
         LOAD_GLES(glGetIntegerv);
         gles_glGetIntegerv(GL_VIEWPORT, (GLint*)&newstate->raster.viewport);
         gles_glGetIntegerv(GL_SCISSOR_BOX, (GLint*)&newstate->raster.scissor);
+        newstate->raster.viewport_known = 1;
+        newstate->raster.scissor_known = 1;
     }
     glstate = newstate;
 }
