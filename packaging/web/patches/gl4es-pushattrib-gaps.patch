@@ -598,8 +634,14 @@ DBG(printf("glPopAttrib()\n");)
 			}
 		}
 		gl4es_glMatrixMode(cur->matrix_mode);
-		enable_disable(GL_NORMALIZE, cur->normalize_flag);		
-		enable_disable(GL_RESCALE_NORMAL, cur->rescale_normal_flag);		
+		enable_disable(GL_NORMALIZE, cur->normalize_flag);
