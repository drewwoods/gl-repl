diff --git a/src/gl/listdraw.c b/src/gl/listdraw.c
index d890b9bd..a3c965fd 100644
--- a/src/gl/listdraw.c
+++ b/src/gl/listdraw.c
@@ -257,6 +257,109 @@ void listInactiveVBO(renderlist_t* list, save_vbo_t* saved) {
     }
 }
 
+/* Edge flags (glEdgeFlag) select which polygon boundary edges are drawn when
+ * the polygon mode is GL_LINE: GL draws the edge that *begins* at a vertex
+ * only if that vertex's flag was GL_TRUE.
+ *
+ * This cannot be done by filtering fill_lineIndices()'s output.  That
+ * function works from the already-triangulated index array, so by the time it
+ * runs a quad has become two triangles: it emits the interior diagonal as a
+ * real edge, and it emits the pairs unoriented (a GL_QUADS block comes out as
+ * (0,1) (0,2) (1,2) (0,3) (2,3), where the boundary edge 3->0 appears as
+ * (0,3)).  Neither "which vertex starts this edge" nor "is this edge a
+ * boundary at all" survives that, so a filter over those pairs suppresses the
+ * wrong edges.
+ *
+ * The vertices themselves, though, are still in specification order -
+ * triangulation reorders the *indices*, not the array - and modeinit_t.vlen
+ * records each block's vertex span.  So flagged geometry gets its edges built
+ * here instead, straight from the original primitive topology.
+ *
+ * Returns the number of indices written, or -1 for a topology this does not
+ * reconstruct (triangle strips and fans, whose edge count is not bounded by
+ * the caller's 4-per-vertex allocation); the caller then falls back to
+ * fill_lineIndices() and the flags are ignored, as they were before.
+ * GL_QUAD_STRIP is reconstructed - a quad strip emits 4 edges per quad, or
+ * 4V-8 indices for V vertices, which fits.
+ *
+ * Note this also drops the triangulation diagonal that fill_lineIndices()
+ * would have drawn inside a quad or polygon.  That is what GL does - the
+ * diagonal is an internal edge, not a boundary - so flagged geometry gets the
+ * more correct outline.  Unflagged geometry keeps gl4es's existing behavior;
+ * fixing that for everything is a separate change.
+ */
+#define EDGE_EMIT(a, b)                                   \
+    do {                                                  \
+        if (edgeflag[(a)]) {                              \
+            ind_line[k++] = (GLushort)(a);                \
+            ind_line[k++] = (GLushort)(b);                \
+        }                                                 \
+    } while (0)
+
+static int build_lineIndices_edgeflag(const modeinit_t *modes, int length,
+                                      int total_verts,
+                                      const GLubyte *edgeflag,
+                                      GLushort *ind_line)
+{
+    int k = 0;
+    int start = 0;
+    for (int m = 0; m < length; ++m) {
+        /* The last block's recorded span can lag the list's final length
+         * (rlEnd trims, and a block is stamped as the next one opens), so the
+         * tail always runs to the real vertex count. */
+        int end = (m + 1 < length) ? modes[m].vlen : total_verts;
+        if (end > total_verts)
+            end = total_verts;
+        if (end < start)
+            return -1;      /* bookkeeping we do not trust: use the old path */
+        int len = end - start;
+        if (len == 0)
+            continue;
+        switch (modes[m].mode_init) {
+            case GL_TRIANGLES:
+                for (int i = 0; i + 2 < len; i += 3) {
+                    int a = start + i;
+                    EDGE_EMIT(a + 0, a + 1);
+                    EDGE_EMIT(a + 1, a + 2);
+                    EDGE_EMIT(a + 2, a + 0);
+                }
+                break;
+            case GL_QUADS:
+                for (int i = 0; i + 3 < len; i += 4) {
+                    int a = start + i;
+                    EDGE_EMIT(a + 0, a + 1);
+                    EDGE_EMIT(a + 1, a + 2);
