     if(face==GL_FRONT_AND_BACK || face==GL_FRONT)
         glstate->material.front.colormat = mode;
     if(face==GL_FRONT_AND_BACK || face==GL_BACK)
         glstate->material.back.colormat = mode;
-    if(glstate->fpe_state) {
