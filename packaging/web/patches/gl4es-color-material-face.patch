-            case GL_EMISSION: value = FPE_CM_EMISSION; break;
-            case GL_AMBIENT: value=FPE_CM_AMBIENT; break;
-            case GL_DIFFUSE: value=FPE_CM_DIFFUSE; break;
-            case GL_SPECULAR: value=FPE_CM_SPECULAR; break;
