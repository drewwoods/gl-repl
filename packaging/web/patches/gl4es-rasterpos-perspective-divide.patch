Fix glRasterPos3f in gl4es to perspective-divide by the clip-space w
component before deriving NDC / viewport coordinates. Without this, the
raster position is wrong under any non-identity projection (e.g. gl-repl's
label()/glRasterPos3f pairing in a perspective scene), since transl[0..2]
are clip-space, not NDC, until divided by transl[3].

Clip-space w<=0, a non-finite divide, or NDC outside [-1, 1] invalidates
the raster position (rPos_valid=0) so a later glBitmap/label is ignored
instead of keeping the previous on-screen position. glWindowPos3f sets
the same flag.

Local fix in ~/src/gl4es (uncommitted upstream at time of writing; not yet
in a public fork). Applied by scripts/web-deps.sh after cloning gl4es,
before building, so the wasm web build gets it without depending on that
local checkout.

diff --git a/src/gl/glstate.c b/src/gl/glstate.c
index b0e87bfc..11929120 100644
--- a/src/gl/glstate.c
+++ b/src/gl/glstate.c
@@ -172,6 +172,7 @@ void* NewGLState(void* shared_glstate, int es2only) {
     //raster & viewport
     glstate->raster.raster_zoomx=1.0f;
     glstate->raster.raster_zoomy=1.0f;
+    glstate->raster.rPos_valid = GL_TRUE;
     glstate->raster.map_i2i_size=1;
     glstate->raster.map_i2r_size=1;
     glstate->raster.map_i2g_size=1;
diff --git a/src/gl/raster.c b/src/gl/raster.c
index 1235a49d..9a5bc4de 100644
--- a/src/gl/raster.c
+++ b/src/gl/raster.c
@@ -1,5 +1,7 @@
 #include "raster.h"
 
+#include <math.h>
+
 #include "../glx/hardext.h"
 #include "blit.h"
 #include "debug.h"
@@ -34,14 +36,33 @@ void APIENTRY_GL4ES gl4es_glRasterPos3f(GLfloat x, GLfloat y, GLfloat z) {
     matrix_transpose(glmatrix, modelview);
     matrix_vector(modelview, transl, t);
     matrix_vector(projection, t, transl);
-    GLfloat w2, h2;
-    w2=glstate->raster.viewport.width/2.0f;
-    h2=glstate->raster.viewport.height/2.0f;
-    
-    if ((transl[0] * w2 + w2) >= 0 && (transl[1] * h2 + h2) >= 0 && transl[2] >= 0) {
-      glstate->raster.rPos.x = transl[0]*w2+w2;
-      glstate->raster.rPos.y = transl[1]*h2+h2;
-      glstate->raster.rPos.z = transl[2];
+    /* Clip-space w<=0 (or a non-finite divide) invalidates the raster
+     * position: later glBitmap / label() must be ignored rather than
+     * keep drawing at the previous on-screen rPos. */
+    if (transl[3] <= 0.0f) {
+      glstate->raster.rPos_valid = GL_FALSE;
+      return;
+    }
+    {
+      GLfloat invw = 1.0f / transl[3];
+      GLfloat ndc_x = transl[0] * invw;
+      GLfloat ndc_y = transl[1] * invw;
+      GLfloat ndc_z = transl[2] * invw;
+      GLfloat w2, h2;
+      w2=glstate->raster.viewport.width/2.0f;
+      h2=glstate->raster.viewport.height/2.0f;
+
+      if (isfinite(ndc_x) && isfinite(ndc_y) && isfinite(ndc_z)
+          && ndc_x >= -1.0f && ndc_x <= 1.0f
+          && ndc_y >= -1.0f && ndc_y <= 1.0f
+          && ndc_z >= -1.0f && ndc_z <= 1.0f) {
+        glstate->raster.rPos.x = ndc_x*w2+w2;
+        glstate->raster.rPos.y = ndc_y*h2+h2;
+        glstate->raster.rPos.z = ndc_z*0.5f+0.5f;
+        glstate->raster.rPos_valid = GL_TRUE;
+      } else {
+        glstate->raster.rPos_valid = GL_FALSE;
+      }
     }
 }
 #if !defined(NO_EGL) && !defined(NOX11)
@@ -59,7 +80,10 @@ void APIENTRY_GL4ES gl4es_glWindowPos3f(GLfloat x, GLfloat y, GLfloat z) {
     if (x >= 0 && y >= 0 && z >= 0) {
       glstate->raster.rPos.x = x;
       glstate->raster.rPos.y = y;
-      glstate->raster.rPos.z = z;	
+      glstate->raster.rPos.z = z;
+      glstate->raster.rPos_valid = GL_TRUE;
+    } else {
+      glstate->raster.rPos_valid = GL_FALSE;
     }
 }
 
diff --git a/src/gl/state.h b/src/gl/state.h
index 02a7d3d7..81448352 100644
--- a/src/gl/state.h
+++ b/src/gl/state.h
@@ -124,6 +124,7 @@ typedef struct {
 
 typedef struct {
     rasterpos_t rPos;
+    GLboolean   rPos_valid;     /* 0 once glRasterPos clips or w<=0 */
     viewport_t viewport;
     viewport_t scissor;
     GLfloat raster_scale[4];
