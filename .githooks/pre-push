#!/bin/sh
# Pre-push gate: run the headless test suite before publishing.
#
# Catches the class of bug where a commit lands on origin without ever
# having `make test-stubs` exercised locally. test-stubs is the ASan +
# UBSan run that builds against the bundled GL stubs, so no system GL
# dev libs are required.
#
# Install once per clone: `make install-hooks`. Bypass with `git push
# --no-verify` if you must (e.g. pushing a WIP branch).
set -e

cd "$(git rev-parse --show-toplevel)"
make --no-print-directory check-trailing-whitespace
exec make --no-print-directory test-stubs TEST_JOBS=6
