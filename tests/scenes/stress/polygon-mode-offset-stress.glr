// @cfg grid = GRID_THEME_CLASSIC
// @cfg vertex_points = 0
// @cfg vertex_outlines = 0
// glPolygonMode cycling (FILL/LINE/POINT) with glPolygonOffset to separate
// coplanar wire overlays from filled solids. Also toggles face targets.

static float spin;
glTranslatef(0.0000f, 0.0000f, -10.0000f);   // @camera dist
glRotatef(22.0000f, 1.0f, 0.0f, 0.0f);   // @camera rx
glRotatef(0.0000f, 0.0f, 1.0f, 0.0f);   // @camera ry
glTranslatef(-0.0000f, -0.0000f, -0.0000f);   // @camera pan

glRotatef(18.0 * t, 0.0, 1.0, 0.0);

glClearColor(0.05, 0.06, 0.08, 1);
glClear(GL_COLOR_BUFFER_BIT | GL_DEPTH_BUFFER_BIT);
glEnable(GL_DEPTH_TEST);
glEnable(GL_LIGHTING);
glEnable(GL_LIGHT0);
glEnable(GL_NORMALIZE);
glEnable(GL_COLOR_MATERIAL);
glColorMaterial(GL_FRONT_AND_BACK, GL_AMBIENT_AND_DIFFUSE);

spin = 30.0 * t;

// Filled solid with offset wire overlay (classic no-z-fight pair)
glPushMatrix();
  glTranslatef(-2.2, 0, 0);
  glRotatef(spin, 1.0, 1.0, 0.0);
  glPolygonMode(GL_FRONT_AND_BACK, GL_FILL);
  glColor3f(1, 0.35, 0.2);
  glutSolidTeapot(0.85);
  glEnable(GL_POLYGON_OFFSET_LINE);
  glPolygonOffset(1, 1);
  glPolygonMode(GL_FRONT_AND_BACK, GL_LINE);
  glLineWidth(1.5);
  glColor3f(0.92, 0.95, 0.98);
  glutSolidTeapot(0.85);
  glDisable(GL_POLYGON_OFFSET_LINE);
glPopMatrix();

// Point mode solid
glPushMatrix();
  glTranslatef(0, 0, 0);
  glRotatef(spin * 0.7, 0.0, 1.0, 1.0);
  glPolygonMode(GL_FRONT_AND_BACK, GL_POINT);
  glPointSize(4);
  glColor3f(0.1, 0.95, 0.85);
  glutSolidSphere(1, 16, 12);
glPopMatrix();

// Per-face modes: front fill, back line (visible if culled off)
glPushMatrix();
  glTranslatef(2.2, 0, 0);
  glRotatef(spin * 1.2, 1.0, 0.0, 1.0);
  glDisable(GL_CULL_FACE);
  glPolygonMode(GL_FRONT, GL_FILL);
  glPolygonMode(GL_BACK, GL_LINE);
  glColor3f(0.15, 0.55, 1);
  glutSolidCube(1.3);
  // Offset fill under a second LINE pass on both faces
  glEnable(GL_POLYGON_OFFSET_FILL);
  glPolygonOffset(1, 2);
  glPolygonMode(GL_FRONT_AND_BACK, GL_FILL);
  glColor3f(0.55, 0.3, 1);
  glutSolidCube(0.7);
  glDisable(GL_POLYGON_OFFSET_FILL);
glPopMatrix();

// Restore defaults
glPolygonMode(GL_FRONT_AND_BACK, GL_FILL);
glDisable(GL_LIGHTING);
