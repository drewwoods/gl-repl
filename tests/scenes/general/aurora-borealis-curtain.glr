// @cfg grid = GRID_THEME_OFF
// @cfg vertex_points = 0
// @cfg vertex_outlines = 0

static float strips = 5;
static float segs = 30;
static float x, frac, wave, height;
static float r, g, b_col, alpha;
static float depth, phase, sway, intensity;
glTranslatef(0.0000f, 0.0000f, -8.0000f);   // @camera dist
glRotatef(10.0000f, 1.0f, 0.0f, 0.0f);   // @camera rx
glRotatef(0.0000f, 0.0f, 1.0f, 0.0f);   // @camera ry
glTranslatef(-0.0000f, -1.0000f, -0.0000f);   // @camera pan


// Dark night sky
glClearColor(0.01, 0.01, 0.04, 1);
glClear(GL_COLOR_BUFFER_BIT | GL_DEPTH_BUFFER_BIT);
glEnable(GL_DEPTH_TEST);
glDepthMask(GL_FALSE);

// Additive blending for aurora glow
glEnable(GL_BLEND);
glBlendFunc(GL_SRC_ALPHA, GL_ONE);

// Draw multiple aurora curtain layers back to front
for(layer, 0, strips) {
  depth = -3.0 + layer * 1.2;
  phase = layer * 1.7;
  intensity = 0.3 + 0.15 * sin(t * 0.4 + layer * 2.1);

  glPushMatrix();
    glTranslatef(0.0, 0.0, depth);

    // Slight lateral sway per layer
    sway = 0.3 * sin(t * 0.5 + phase);
    glTranslatef(sway, 0.0, 0.0);

    glBegin(GL_QUAD_STRIP);
      for(seg, 0, segs) {
        frac = seg / (segs - 1.0);
        x = -5.0 + frac * 10.0;

        // Curtain wave: height oscillates with x and time
        wave = sin(x * 0.8 + t * 0.7 + phase) * 0.6 + sin(x * 1.5 - t * 0.5 + phase * 0.6) * 0.3 + cos(x * 0.4 + t * 0.3) * 0.4;
        height = 2.5 + wave;

        // Bottom vertex: green, more transparent
        r = 0.05 + 0.05 * sin(x * 0.5 + t * 0.3);
        g = 0.5 + 0.2 * sin(x * 0.7 + t * 0.6 + phase);
        b_col = 0.1;
        alpha = intensity * (0.25 + 0.15 * sin(x * 1.2 + t + phase));
        glColor4f(r, g, b_col, alpha);
        glVertex3f(x, -0.5, 0.0);

        // Top vertex: cyan to purple/magenta
        r = 0.3 + 0.25 * sin(x * 0.6 + t * 0.4 + phase * 1.3);
        g = 0.15 + 0.15 * cos(x * 0.9 + t * 0.5);
        b_col = 0.5 + 0.3 * sin(x * 0.3 - t * 0.2 + phase);
        alpha = intensity * (0.15 + 0.1 * sin(x * 0.8 - t * 0.7));
        glColor4f(r, g, b_col, alpha);
        glVertex3f(x, height, 0.0);
      }
    glEnd();

    // Second pass: brighter inner glow ribbon (narrower)
    glBegin(GL_QUAD_STRIP);
      for(seg, 0, segs) {
        frac = seg / (segs - 1.0);
        x = -5.0 + frac * 10.0;

        wave = sin(x * 0.8 + t * 0.7 + phase) * 0.6 + sin(x * 1.5 - t * 0.5 + phase * 0.6) * 0.3 + cos(x * 0.4 + t * 0.3) * 0.4;
        height = 2.5 + wave;

        // Inner glow bottom: bright green core
        r = 0.1;
        g = 0.8 + 0.2 * sin(x * 0.6 + t * 0.8 + phase);
        b_col = 0.2;
        alpha = intensity * 0.12;
        glColor4f(r, g, b_col, alpha);
        glVertex3f(x, 0.3, 0.0);

        // Inner glow top: bright cyan core
        r = 0.1;
        g = 0.6 + 0.2 * sin(x * 0.5 + t * 0.6);
        b_col = 0.7 + 0.2 * cos(x * 0.4 + t * 0.3);
        alpha = intensity * 0.08;
        glColor4f(r, g, b_col, alpha);
        glVertex3f(x, height * 0.7, 0.0);
      }
    glEnd();

  glPopMatrix();
}

// Faint star field behind the aurora
glPointSize(2);
glBegin(GL_POINTS);
  for(i, 0, 60) {
    x = sin(i * 47.3) * 6.0;
    height = 1.0 + sin(i * 31.7) * 2.5;
    depth = -5.0 + sin(i * 19.1) * 2.0;
    alpha = 0.15 + 0.1 * sin(t * 0.8 + i * 3.7);
    glColor4f(0.7, 0.7, 0.8, alpha);
    glVertex3f(x, height, depth);
  }
glEnd();

glDepthMask(GL_TRUE);
glDisable(GL_BLEND);
