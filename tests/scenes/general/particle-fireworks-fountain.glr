// @cfg grid = GRID_THEME_OFF
// @cfg vertex_points = 0
// @cfg vertex_outlines = 0

static float p_count = 174.9; // @tune
static float dt, frac, phi, theta, spd, px, py, pz;
static float r_col, g_col, b_col, a_col;
static float ring_u, cu, su;

display() {
  glTranslatef(0.0000f, 0.0000f, -6.0634f);   // @camera dist
  glRotatef(14.0000f, 1.0f, 0.0f, 0.0f);   // @camera rx
  glRotatef(5.0000f, 0.0f, 1.0f, 0.0f);   // @camera ry
  glTranslatef(-0.0000f, -1.0000f, -0.0000f);   // @camera pan

  glClearColor(0.02, 0.02, 0.05, 1);
  glClear(GL_COLOR_BUFFER_BIT | GL_DEPTH_BUFFER_BIT);

  glEnable(GL_DEPTH_TEST);
  glDepthMask(GL_FALSE);
  glEnable(GL_BLEND);
  glBlendFunc(GL_SRC_ALPHA, GL_ONE);

  // Fountain 1: Center Golden/Amber Fountain
  glPointSize(4);
  glBegin(GL_POINTS);
    for(i, 0, p_count) {
      frac = i / p_count;
      dt = fmod(t * 1.6 + frac * 2.2, 2.2);
      phi = i * 2.39996 + t * 0.2;
      theta = 1.15 + 0.35 * sin(i * 1.7);
      spd = 4.2 + 0.8 * sin(i * 3.1);

      px = cos(phi) * cos(theta) * spd * dt;
      pz = sin(phi) * cos(theta) * spd * dt;
      py = sin(theta) * spd * dt - 0.5 * 3.8 * dt * dt;

      a_col = clamp(1.0 - (dt / 2.2), 0.0, 1.0);
      r_col = 1.0;
      g_col = 0.85 - 0.5 * (dt / 2.2);
      b_col = 0.3 * (1.0 - dt / 2.2);

      glColor4f(r_col, g_col, b_col, a_col * 0.9);
      glVertex3f(px, py, pz);
    }
  glEnd();

  // Fountain 2: Left Magenta/Violet Fountain
  glPushMatrix();
    glTranslatef(-3.2, 0, 0);
    glPointSize(3.5);
    glBegin(GL_POINTS);
      for(i, 0, p_count) {
        frac = i / p_count;
        dt = fmod(t * 1.8 + frac * 2.0 + 0.7, 2.0);
        phi = i * 2.39996;
        theta = 1.2 + 0.3 * cos(i * 2.1);
        spd = 3.8 + 0.6 * sin(i * 4.3);

        px = cos(phi) * cos(theta) * spd * dt;
        pz = sin(phi) * cos(theta) * spd * dt;
        py = sin(theta) * spd * dt - 0.5 * 3.8 * dt * dt;

        a_col = clamp(1.0 - (dt / 2.0), 0.0, 1.0);
        r_col = 0.95;
        g_col = 0.2 + 0.4 * (1.0 - dt / 2.0);
        b_col = 0.9;

        glColor4f(r_col, g_col, b_col, a_col * 0.85);
        glVertex3f(px, py, pz);
      }
    glEnd();
  glPopMatrix();

  // Fountain 3: Right Cyan/Electric-Blue Fountain
  glPushMatrix();
    glTranslatef(3.2, 0, 0);
    glPointSize(3.5);
    glBegin(GL_POINTS);
      for(i, 0, p_count) {
        frac = i / p_count;
        dt = fmod(t * 1.8 + frac * 2.0 + 1.3, 2.0);
        phi = i * 2.39996;
        theta = 1.2 + 0.3 * sin(i * 2.7);
        spd = 3.8 + 0.6 * cos(i * 3.5);

        px = cos(phi) * cos(theta) * spd * dt;
        pz = sin(phi) * cos(theta) * spd * dt;
        py = sin(theta) * spd * dt - 0.5 * 3.8 * dt * dt;

        a_col = clamp(1.0 - (dt / 2.0), 0.0, 1.0);
        r_col = 0.15;
        g_col = 0.85 - 0.3 * (dt / 2.0);
        b_col = 1.0;

        glColor4f(r_col, g_col, b_col, a_col * 0.85);
        glVertex3f(px, py, pz);
      }
    glEnd();
  glPopMatrix();

  // Glowing launch pads at bases
  glLineWidth(2);
  glColor4f(1, 0.8, 0.3, 0.6);
  glBegin(GL_LINE_LOOP);
    for(i, 0, 24) {
      ring_u = i * (TAU / 24.0);
      glVertex3f(cos(ring_u) * 0.6, 0.0, sin(ring_u) * 0.6);
    }
  glEnd();

  glColor4f(0.9, 0.2, 0.8, 0.5);
  glBegin(GL_LINE_LOOP);
    for(i, 0, 24) {
      ring_u = i * (TAU / 24.0);
      glVertex3f(-3.2 + cos(ring_u) * 0.5, 0.0, sin(ring_u) * 0.5);
    }
  glEnd();

  glColor4f(0.2, 0.8, 1, 0.5);
  glBegin(GL_LINE_LOOP);
    for(i, 0, 24) {
      ring_u = i * (TAU / 24.0);
      glVertex3f(3.2 + cos(ring_u) * 0.5, 0.0, sin(ring_u) * 0.5);
    }
  glEnd();

  glDepthMask(GL_TRUE);
  glDisable(GL_BLEND);
}
