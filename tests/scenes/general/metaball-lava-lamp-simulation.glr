// @cfg grid = GRID_THEME_OFF
// @cfg vertex_points = 0
// @cfg vertex_outlines = 0
static float count = 40;
static float id, phase, bx, by, bz, sz;
static float r, g, b;
glTranslatef(0.0000f, 0.0000f, -7.5000f);   // @camera dist
glRotatef(10.0000f, 1.0f, 0.0f, 0.0f);   // @camera rx
glRotatef(0.0000f, 0.0f, 1.0f, 0.0f);   // @camera ry
glTranslatef(-0.0000f, -0.0000f, -0.0000f);   // @camera pan


glClearColor(0.02, 0.03, 0.05, 1);
glClear(GL_COLOR_BUFFER_BIT | GL_DEPTH_BUFFER_BIT);
glEnable(GL_DEPTH_TEST);
glEnable(GL_LIGHTING);
glEnable(GL_LIGHT0);

for(i, 0, count) {
  id = i;
  phase = id * 0.25;

  bx = 1.5 * sin(t * 0.8 + phase);
  by = 2.2 * sin(t * 1.3 + phase * 1.7);
  bz = 1.2 * cos(t * 0.9 + phase * 0.8);
  sz = 0.25 + 0.15 * sin(t * 2.0 + id);

  r = 0.8 + 0.2 * sin(id);
  g = 0.3 + 0.3 * cos(id * 1.3);
  b = 0.2 + 0.2 * sin(id * 0.7);

  glPushMatrix();
    glTranslatef(bx, by, bz);
    glMaterialfv(GL_FRONT_AND_BACK, GL_DIFFUSE, (GLfloat[]){r, g, b, 1.0});
    glutSolidSphere(sz, 14, 14);
  glPopMatrix();
}
