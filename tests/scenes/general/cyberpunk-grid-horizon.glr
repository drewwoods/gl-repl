// @cfg grid = GRID_THEME_OFF
// @cfg vertex_points = 0
// @cfg vertex_outlines = 0

static float x_pos, z_pos, z_offset;
static float sun_u, sun_y, slat_y;
static float r_col, g_col, b_col;

glTranslatef(0.0000f, 0.0000f, -8.0000f);   // @camera dist
glRotatef(12.0000f, 1.0f, 0.0f, 0.0f);   // @camera rx
glRotatef(0.0000f, 0.0f, 1.0f, 0.0f);   // @camera ry
glTranslatef(0.0000f, -1.2000f, 0.0000f);   // @camera pan

glClearColor(0.04, 0.01, 0.08, 1.0);
glClear(GL_COLOR_BUFFER_BIT | GL_DEPTH_BUFFER_BIT);
glEnable(GL_DEPTH_TEST);

// --- 1. Distant Segmented Retro Sun (Center Horizon) ---
glPushMatrix();
  glTranslatef(0.0, 2.2, -18.0);

  // Sun horizontal slats with gradient from golden yellow (top) to magenta (bottom)
  for(i, 0, 16) {
    slat_y = 3.0 - i * 0.38;
    r_col = 1.0;
    g_col = clamp(0.9 - i * 0.06, 0.1, 1.0);
    b_col = clamp(0.1 + i * 0.05, 0.0, 0.8);

    glBegin(GL_QUADS);
      glColor3f(r_col, g_col, b_col);
      // Width of circular chord at this y
      if(slat_y < 3.0 && slat_y > -3.0) {
        sun_u = sqrt(9.0 - slat_y * slat_y);
        glVertex3f(-sun_u, slat_y, 0.0);
        glVertex3f( sun_u, slat_y, 0.0);
        glVertex3f( sun_u, slat_y - 0.28, 0.0);
        glVertex3f(-sun_u, slat_y - 0.28, 0.0);
      }
    glEnd();
  }
glPopMatrix();

// --- 2. Distant Horizon Mountain Ridge (Neon Magenta / Purple Wireframe) ---
glLineWidth(2.0);
glBegin(GL_LINE_STRIP);
  glColor3f(0.85, 0.20, 0.75);
  glVertex3f(-16.0, 0.0, -16.0);
  glVertex3f(-12.0, 1.4, -16.0);
  glVertex3f( -9.0, 0.5, -16.0);
  glVertex3f( -6.0, 2.2, -16.0);
  glVertex3f( -3.0, 0.8, -16.0);
  glVertex3f(  0.0, 1.8, -16.0);
  glVertex3f(  3.0, 0.6, -16.0);
  glVertex3f(  6.0, 2.5, -16.0);
  glVertex3f(  9.0, 1.1, -16.0);
  glVertex3f( 12.0, 1.6, -16.0);
  glVertex3f( 16.0, 0.0, -16.0);
glEnd();

// Horizon glow line
glLineWidth(3.0);
glBegin(GL_LINES);
  glColor3f(0.3, 0.9, 1.0);
  glVertex3f(-16.0, 0.0, -16.0);
  glVertex3f( 16.0, 0.0, -16.0);
glEnd();

// --- 3. Perspective Neon Highway Grid ---
// Scrolling transverse lines along Z
z_offset = fmod(t * 3.5, 1.2);

glLineWidth(1.5);
for(i, 0, 18) {
  z_pos = -0.5 - (i * 0.9 - z_offset);
  if(z_pos > -16.0 && z_pos < 0.5) {
    glBegin(GL_LINES);
      // Brightness fades into horizon distance
      r_col = 0.8 * (1.0 + z_pos / 16.0);
      g_col = 0.2 * (1.0 + z_pos / 16.0);
      b_col = 0.9 * (1.0 + z_pos / 16.0);
      glColor3f(r_col, g_col, b_col);
      glVertex3f(-8.0, 0.0, z_pos);
      glVertex3f( 8.0, 0.0, z_pos);
    glEnd();
  }
}

// Longitudinal lines radiating into distance
glLineWidth(2.0);
for(i, -6, 7) {
  x_pos = i * 1.2;
  glBegin(GL_LINES);
    if(i == 0) {
      // Center yellow road divider
      glColor3f(1.0, 0.85, 0.2);
    }
    if(i != 0) {
      // Cyan grid lanes
      glColor3f(0.1, 0.8, 0.95);
    }
    glVertex3f(x_pos * 1.5, 0.0, 0.5);
    glVertex3f(x_pos * 0.4, 0.0, -16.0);
  glEnd();
}
