// @cfg view_mode = RENDER3D_VIEW_3D
// @cfg axes = AXES_THEME_OFF
// @cfg grid = GRID_THEME_CLASSIC
static float wy, s; // wave height, color mix

glTranslatef(0.0f, 0.0f, -9.00f);   // @camera dist
glRotatef(40.0f, 1.0f, 0.0f, 0.0f);   // @camera rx
glRotatef(30.0f, 0.0f, 1.0f, 0.0f);   // @camera ry
glTranslatef(0.0f, 0.0f, 0.0f);   // @camera pan

glClearColor(0.05f, 0.06f, 0.08f, 1.0f);
glClear(GL_COLOR_BUFFER_BIT | GL_DEPTH_BUFFER_BIT);
glEnable(GL_DEPTH_TEST);

// Draw a 20x20 parametric wave grid as quads
for(i, 0, 20) {
  for(j, 0, 20) {
    wy = sin((i - 10) * 0.4f + t) * cos((j - 10) * 0.4f + t) * 0.8f;
    s = wy * 0.5f + 0.5f;

    // Mix AZURE (0.15, 0.55, 1.0) -> TEAL (0.10, 0.95, 0.85)
    glColor3f(0.15f - 0.05f * s, 0.55f + 0.40f * s, 1.00f - 0.15f * s);

    glBegin(GL_QUADS);
      glVertex3f((i - 10) * 0.45f,       wy,                              (j - 10) * 0.45f);
      glVertex3f((i - 10 + 1) * 0.45f,   sin((i - 9) * 0.4f + t) * cos((j - 10) * 0.4f + t) * 0.8f, (j - 10) * 0.45f);
      glVertex3f((i - 10 + 1) * 0.45f,   sin((i - 9) * 0.4f + t) * cos((j - 9) * 0.4f + t) * 0.8f,  (j - 10 + 1) * 0.45f);
      glVertex3f((i - 10) * 0.45f,       sin((i - 10) * 0.4f + t) * cos((j - 9) * 0.4f + t) * 0.8f,  (j - 10 + 1) * 0.45f);
    glEnd();
  }
}
