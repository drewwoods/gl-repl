// @cfg grid = GRID_THEME_OFF
// @cfg vertex_points = 0
// @cfg vertex_outlines = 0
// Regression: rand/rand2 are the only builtins whose call may legally omit
// an argument (arity_min 1, arity_max 2). The evaluator reads the missing
// `iter` out of a zero-filled args[]; the exported C helpers have fixed
// two-parameter signatures, so lowering has to write that 0 back out. This
// scene exists to put the one-argument form through the corpus's
// export-and-compile pass -- the shipped catalog only ever spells both
// arguments, so nothing else covers it.
//
// Every position below is one-argument on purpose. Do not "tidy" them into
// the two-argument form: that is exactly the coverage this file is here for.
static float spread = 2.6;

display() {
  glTranslatef(0.0000f, 0.0000f, -8.0000f);   // @camera dist
  glRotatef(18.0f, 1.0f, 0.0f, 0.0f);   // @camera rx
  glRotatef(24.0f, 0.0f, 1.0f, 0.0f);   // @camera ry
  glTranslatef(0.0000f, 0.0000f, 0.0000f);   // @camera pan

  glClearColor(0.05, 0.06, 0.08, 1);
  glClear(GL_COLOR_BUFFER_BIT | GL_DEPTH_BUFFER_BIT);

  glEnable(GL_DEPTH_TEST);
  glPointSize(6);
  glBegin(GL_POINTS);
    for(i, 0, 24) {
      // Bare rand(i): the padded argument has to land inside this call.
      glColor3f(rand(i), 0.95, 0.85);
      // Nested and sibling forms - the default belongs to the call that
      // opened the paren, not the nearest one.
      glVertex3f(rand2(i)*spread, rand2(sin(i))*spread, rand2(i + 1)*spread);
    }
  glEnd();
}
