// @cfg grid = GRID_THEME_OFF
// @cfg vertex_points = 0
// @cfg vertex_outlines = 0
// Distance-attenuated point sprites. glPointParameterfv is
// runtime-gated (no-op + glPointSize fallback when the entry point
// is missing), but the line still parses and exports. Additive
// blend keeps the glow when the size falls off with distance.
static float count = 90;
static float ang, rad, px, py, pz, heat;

glTranslatef(0.0f, 0.0f, -7.00f);   // @camera dist
glRotatef(20.0f, 1.0f, 0.0f, 0.0f);   // @camera rx
glRotatef(14.0f, 0.0f, 1.0f, 0.0f);   // @camera ry
glTranslatef(0.0f, -0.20f, 0.0f);   // @camera pan

glClearColor(0.05, 0.06, 0.08, 1);
glClear(GL_COLOR_BUFFER_BIT | GL_DEPTH_BUFFER_BIT);

// Hearth
glEnable(GL_DEPTH_TEST);
glEnable(GL_LIGHTING);
glEnable(GL_LIGHT0);
glEnable(GL_COLOR_MATERIAL);
glColorMaterial(GL_FRONT_AND_BACK, GL_AMBIENT_AND_DIFFUSE);
glPushMatrix();
  glTranslatef(0, -1.15, 0);
  glScalef(2.2, 0.22, 2.2);
  glColor3f(0.55, 0.30, 1.00);
  glutSolidCube(1);
glPopMatrix();
glPushMatrix();
  glTranslatef(0, -0.85, 0);
  glColor3f(1.00, 0.35, 0.20);
  glutSolidSphere(0.35, 16, 12);
glPopMatrix();

glDisable(GL_LIGHTING);
glDisable(GL_DEPTH_TEST);
glEnable(GL_BLEND);
glBlendFunc(GL_SRC_ALPHA, GL_ONE);
glEnable(GL_POINT_SMOOTH);
glPointSize(18);
glPointParameterfv(GL_POINT_DISTANCE_ATTENUATION, 0.15, 0.05, 0.22);

glBegin(GL_POINTS);
  for(i, 0, count) {
    ang = rand(i, 0) * TAU + t * (0.25 + 0.55 * rand(i, 1));
    rad = 0.2 + rand(i, 2) * 1.6;
    px = cos(ang) * rad;
    pz = sin(ang) * rad;
    py = -0.4 + fmod(t * (0.4 + rand(i, 3)) + rand(i, 4) * 3, 2.8);
    heat = 1 - py / 2.4;
    glColor4f(lerp(0.95, 1.00, heat), lerp(0.25, 0.85, heat), lerp(1.00, 0.15, heat), 0.25 + 0.55 * heat);
    glVertex3f(px, py, pz);
  }
glEnd();
glDisable(GL_BLEND);
