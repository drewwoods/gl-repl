// @cfg view_mode = RENDER3D_VIEW_3D
// @cfg axes = AXES_THEME_OFF
// @cfg grid = GRID_THEME_CLASSIC
// @cfg light_theme = LIGHT_THEME_NEON

static float wheel_speed = 15.0;
static float wheel_radius = 3.5;
static float wheel_angle;
static float a1, a2;
static float spoke_angle;
static float sx, sy;

glTranslatef(0.0000f, 0.0000f, -14.0000f);   // @camera dist
glRotatef(15.0000f, 1.0f, 0.0f, 0.0f);   // @camera rx
glRotatef(-10.0000f, 0.0f, 1.0f, 0.0f);   // @camera ry
glTranslatef(0.0000f, -1.0000f, 0.0000f);   // @camera pan

glClearColor(0.03, 0.02, 0.08, 1.0);
glClear(GL_COLOR_BUFFER_BIT | GL_DEPTH_BUFFER_BIT);
glEnable(GL_DEPTH_TEST);
glEnable(GL_LIGHTING);
glEnable(GL_LIGHT0);
glEnable(GL_COLOR_MATERIAL);
glColorMaterial(GL_FRONT_AND_BACK, GL_AMBIENT_AND_DIFFUSE);

wheel_angle = wheel_speed * t;

// Gondola colors stored in scratch arrays (R, G, B per gondola, 8 gondolas)
// Array A = red channel, Array B = green channel, Array C = blue channel
A[0] = 0.9; B[0] = 0.2; C[0] = 0.2;
A[1] = 0.2; B[1] = 0.8; C[1] = 0.3;
A[2] = 0.3; B[2] = 0.4; C[2] = 0.9;
A[3] = 0.9; B[3] = 0.8; C[3] = 0.1;
A[4] = 0.9; B[4] = 0.4; C[4] = 0.0;
A[5] = 0.7; B[5] = 0.2; C[5] = 0.8;
A[6] = 0.1; B[6] = 0.9; C[6] = 0.8;
A[7] = 0.9; B[7] = 0.5; C[7] = 0.6;

// -- A-Frame support structure --
glDisable(GL_LIGHTING);
glColor3f(0.4, 0.4, 0.5);
glLineWidth(2.5);

// Left A-frame leg
glBegin(GL_LINES);
glVertex3f(-1.5, -4.5, -0.8);
glVertex3f(0.0, 0.0, 0.0);
glEnd();
glBegin(GL_LINES);
glVertex3f(-1.5, -4.5, 0.8);
glVertex3f(0.0, 0.0, 0.0);
glEnd();

// Right A-frame leg
glBegin(GL_LINES);
glVertex3f(1.5, -4.5, -0.8);
glVertex3f(0.0, 0.0, 0.0);
glEnd();
glBegin(GL_LINES);
glVertex3f(1.5, -4.5, 0.8);
glVertex3f(0.0, 0.0, 0.0);
glEnd();

// Cross braces on A-frame
glColor3f(0.35, 0.35, 0.45);
glBegin(GL_LINES);
glVertex3f(-1.0, -3.0, -0.5);
glVertex3f(-1.0, -3.0, 0.5);
glEnd();
glBegin(GL_LINES);
glVertex3f(1.0, -3.0, -0.5);
glVertex3f(1.0, -3.0, 0.5);
glEnd();

// Base bar
glBegin(GL_LINES);
glVertex3f(-1.5, -4.5, 0.0);
glVertex3f(1.5, -4.5, 0.0);
glEnd();

glEnable(GL_LIGHTING);

// -- Rotating wheel assembly --
glPushMatrix();
glRotatef(wheel_angle, 0, 0, 1);

// Central hub
glMaterialfv(GL_FRONT_AND_BACK, GL_DIFFUSE, (GLfloat[]){0.6, 0.6, 0.7, 1.0});
glMaterialfv(GL_FRONT_AND_BACK, GL_SPECULAR, (GLfloat[]){0.8, 0.8, 0.8, 1.0});
glMaterialf(GL_FRONT_AND_BACK, GL_SHININESS, 60.0);
glutSolidSphere(0.3, 16, 16);

// Outer rim (two rings for depth)
glDisable(GL_LIGHTING);
glColor3f(0.5, 0.5, 0.6);
glLineWidth(1.5);

// Draw rim as a polygon outline
for(seg, 0, 32) {
    a1 = seg * TAU / 32.0;
    a2 = (seg + 1) * TAU / 32.0;
    glBegin(GL_LINES);
    glVertex3f(wheel_radius * cos(a1), wheel_radius * sin(a1), -0.15);
    glVertex3f(wheel_radius * cos(a2), wheel_radius * sin(a2), -0.15);
    glEnd();
    glBegin(GL_LINES);
    glVertex3f(wheel_radius * cos(a1), wheel_radius * sin(a1), 0.15);
    glVertex3f(wheel_radius * cos(a2), wheel_radius * sin(a2), 0.15);
    glEnd();
}

// Spokes and gondolas
glEnable(GL_LIGHTING);
for(idx, 0, 8) {
    spoke_angle = idx * TAU / 8.0;

    sx = wheel_radius * cos(spoke_angle);
    sy = wheel_radius * sin(spoke_angle);

    // Draw spoke line
    glDisable(GL_LIGHTING);
    glColor3f(0.5, 0.5, 0.55);
    glLineWidth(1.5);
    glBegin(GL_LINES);
    glVertex3f(0, 0, 0);
    glVertex3f(sx, sy, 0);
    glEnd();
    glEnable(GL_LIGHTING);

    // Gondola at spoke end
    glPushMatrix();
    glTranslatef(sx, sy, 0);
    // Counter-rotate so gondola stays upright
    glRotatef(-wheel_angle, 0, 0, 1);

    // Gondola hanger rod
    glDisable(GL_LIGHTING);
    glColor3f(0.45, 0.45, 0.5);
    glBegin(GL_LINES);
    glVertex3f(0, 0, 0);
    glVertex3f(0, -0.4, 0);
    glEnd();
    glEnable(GL_LIGHTING);

    // Gondola cube with unique color
    glPushMatrix();
    glTranslatef(0, -0.65, 0);
    glMaterialfv(GL_FRONT_AND_BACK, GL_DIFFUSE, (GLfloat[]){A[idx], B[idx], C[idx], 1.0});
    glMaterialfv(GL_FRONT_AND_BACK, GL_SPECULAR, (GLfloat[]){0.4, 0.4, 0.4, 1.0});
    glMaterialf(GL_FRONT_AND_BACK, GL_SHININESS, 30.0);
    glutSolidCube(0.45);
    glPopMatrix();

    glPopMatrix();
}

glPopMatrix();
