// @cfg grid = GRID_THEME_OFF
// @cfg vertex_points = 0
// @cfg vertex_outlines = 0
// 4D Hypercube (tesseract) rotating simultaneously across the XW and YZ planes,
// projected into 3D perspective with 16 vertices and 32 connecting edges.
static float a_xw, a_yz, c_xw, s_xw, c_yz, s_yz;
static float sx, sy, sz, sw, w_tmp;
static float x1, y1, z1, w1, s1, p1x, p1y, p1z;
static float x2, y2, z2, w2, s2, p2x, p2y, p2z;

display() {
  glTranslatef(0.0000f, 0.0000f, -8.0000f);   // @camera dist
  glRotatef(20.0000f, 1.0f, 0.0f, 0.0f);   // @camera rx
  glRotatef(30.0000f, 0.0f, 1.0f, 0.0f);   // @camera ry
  glTranslatef(0.0000f, 0.0000f, 0.0000f);   // @camera pan

  glClearColor(0.05, 0.06, 0.08, 1);
  glClear(GL_COLOR_BUFFER_BIT | GL_DEPTH_BUFFER_BIT);
  glEnable(GL_DEPTH_TEST);

  a_xw = 0.85 * t;
  a_yz = 0.55 * t;
  c_xw = cos(a_xw);
  s_xw = sin(a_xw);
  c_yz = cos(a_yz);
  s_yz = sin(a_yz);

  glDisable(GL_LIGHTING);
  glLineWidth(2.2);

  // --- Draw the 32 edges of the 4D Tesseract ---
  glBegin(GL_LINES);
    for(i, 0, 16) {
      // 4D coordinate signs of vertex i
      sx = (fmod(i, 2) >= 1) * 2.0 - 1.0;
      sy = (fmod(floor(i / 2.0), 2) >= 1) * 2.0 - 1.0;
      sz = (fmod(floor(i / 4.0), 2) >= 1) * 2.0 - 1.0;
      sw = (fmod(floor(i / 8.0), 2) >= 1) * 2.0 - 1.0;

      // Rotate vertex i in 4D (XW and YZ planes)
      w_tmp = sx * s_xw + sw * c_xw;
      x1 = sx * c_xw - sw * s_xw;
      w1 = w_tmp;

      w_tmp = sy * s_yz + sz * c_yz;
      y1 = sy * c_yz - sz * s_yz;
      z1 = w_tmp;

      s1 = 1.7 / (3.2 - w1);
      p1x = x1 * s1;
      p1y = y1 * s1;
      p1z = z1 * s1;

      // Connect along X if sx < 0
      if(sx < 0) {
        w_tmp = 1.0 * s_xw + sw * c_xw;
        x2 = 1.0 * c_xw - sw * s_xw;
        w2 = w_tmp;
        w_tmp = sy * s_yz + sz * c_yz;
        y2 = sy * c_yz - sz * s_yz;
        z2 = w_tmp;
        s2 = 1.7 / (3.2 - w2);
        p2x = x2 * s2;
        p2y = y2 * s2;
        p2z = z2 * s2;

        glColor3f(0.15, 0.55, 1.00);
        glVertex3f(p1x, p1y, p1z);
        glVertex3f(p2x, p2y, p2z);
      }

      // Connect along Y if sy < 0
      if(sy < 0) {
        w_tmp = sx * s_xw + sw * c_xw;
        x2 = sx * c_xw - sw * s_xw;
        w2 = w_tmp;
        w_tmp = 1.0 * s_yz + sz * c_yz;
        y2 = 1.0 * c_yz - sz * s_yz;
        z2 = w_tmp;
        s2 = 1.7 / (3.2 - w2);
        p2x = x2 * s2;
        p2y = y2 * s2;
        p2z = z2 * s2;

        glColor3f(0.10, 0.95, 0.85);
        glVertex3f(p1x, p1y, p1z);
        glVertex3f(p2x, p2y, p2z);
      }

      // Connect along Z if sz < 0
      if(sz < 0) {
        w_tmp = sx * s_xw + sw * c_xw;
        x2 = sx * c_xw - sw * s_xw;
        w2 = w_tmp;
        w_tmp = sy * s_yz + 1.0 * c_yz;
        y2 = sy * c_yz - 1.0 * s_yz;
        z2 = w_tmp;
        s2 = 1.7 / (3.2 - w2);
        p2x = x2 * s2;
        p2y = y2 * s2;
        p2z = z2 * s2;

        glColor3f(0.55, 0.30, 1.00);
        glVertex3f(p1x, p1y, p1z);
        glVertex3f(p2x, p2y, p2z);
      }

      // Connect along W if sw < 0
      if(sw < 0) {
        w_tmp = sx * s_xw + 1.0 * c_xw;
        x2 = sx * c_xw - 1.0 * s_xw;
        w2 = w_tmp;
        w_tmp = sy * s_yz + sz * c_yz;
        y2 = sy * c_yz - sz * s_yz;
        z2 = w_tmp;
        s2 = 1.7 / (3.2 - w2);
        p2x = x2 * s2;
        p2y = y2 * s2;
        p2z = z2 * s2;

        glColor3f(1.00, 0.35, 0.20);
        glVertex3f(p1x, p1y, p1z);
        glVertex3f(p2x, p2y, p2z);
      }
    }
  glEnd();

  // --- 16 Corner Vertex Spheres ---
  glEnable(GL_LIGHTING);
  glEnable(GL_LIGHT0);
  glEnable(GL_COLOR_MATERIAL);
  glColorMaterial(GL_FRONT_AND_BACK, GL_AMBIENT_AND_DIFFUSE);

  for(i, 0, 16) {
    sx = (fmod(i, 2) >= 1) * 2.0 - 1.0;
    sy = (fmod(floor(i / 2.0), 2) >= 1) * 2.0 - 1.0;
    sz = (fmod(floor(i / 4.0), 2) >= 1) * 2.0 - 1.0;
    sw = (fmod(floor(i / 8.0), 2) >= 1) * 2.0 - 1.0;

    w_tmp = sx * s_xw + sw * c_xw;
    x1 = sx * c_xw - sw * s_xw;
    w1 = w_tmp;
    w_tmp = sy * s_yz + sz * c_yz;
    y1 = sy * c_yz - sz * s_yz;
    z1 = w_tmp;

    s1 = 1.7 / (3.2 - w1);
    p1x = x1 * s1;
    p1y = y1 * s1;
    p1z = z1 * s1;

    glPushMatrix();
      glTranslatef(p1x, p1y, p1z);
      glColor3f(1.00, 0.85, 0.15);
      glutSolidSphere(0.08, 12, 10);
    glPopMatrix();
  }

  // Telemetry HUD
  glDisable(GL_LIGHTING);
  glColor3f(0.92, 0.95, 0.98);
  glRasterPos3f(-3.2, 2.3, 0);
  label("4D Hypercube Rotation");
  glRasterPos3f(-3.2, 2.0, 0);
  label("XW angle %f deg  YZ angle %f deg", a_xw * 57.2958, a_yz * 57.2958);
}
