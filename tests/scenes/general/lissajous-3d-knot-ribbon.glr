// @cfg view_mode = RENDER3D_VIEW_3D
// @cfg axes = AXES_THEME_OFF
// @cfg grid = GRID_THEME_CLASSIC
static float n = 120;
static float a = 3.0;
static float b = 4.0;
static float c = 5.0;
static float step, u, x, y, z, r, g, b_col;

glTranslatef(0.0000f, 0.0000f, -7.5000f);   // @camera dist
glRotatef(20.0000f, 1.0f, 0.0f, 0.0f);   // @camera rx
glRotatef(0.0000f, 0.0f, 1.0f, 0.0f);   // @camera ry
glTranslatef(0.0000f, 0.0000f, 0.0000f);   // @camera pan

glClearColor(0.03, 0.03, 0.06, 1.0);
glClear(GL_COLOR_BUFFER_BIT | GL_DEPTH_BUFFER_BIT);
glEnable(GL_DEPTH_TEST);
glLineWidth(3.0);

glBegin(GL_LINE_STRIP);
  for(i, 0, n + 1) {
    step = i / n;
    u = step * 6.28318;

    x = 2.2 * sin(a * u + t * 0.8);
    y = 2.2 * cos(b * u + t * 0.5);
    z = 1.8 * sin(c * u + t * 1.2);

    r = 0.5 + 0.5 * sin(u);
    g = 0.5 + 0.5 * sin(u + 2.094);
    b_col = 0.5 + 0.5 * sin(u + 4.188);

    glColor3f(r, g, b_col);
    glVertex3f(x, y, z);
  }
glEnd();
