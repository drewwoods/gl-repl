// @cfg view_mode = RENDER3D_VIEW_3D
// @cfg axes = AXES_THEME_OFF
// @cfg grid = GRID_THEME_OFF
// @cfg vertex_labels = OVERLAY_VERTEX_LABEL_OFF
// @cfg vertex_points = 0
// @cfg vertex_outlines = 0
static float lx, ly, lz;

// A moving virtual light drives the marker and the stencil shadow mask. The REPL's
// configured GL light position is fixed, so the bright pass below is unlit:
// the moving shadow supplies the lighting cue without contradicting the lamp.

room() {
  glBegin(GL_QUADS);
    // Floor, y = 0.
    glNormal3f(0, 1, 0);
    glVertex3f(-4, 0, -4);
    glVertex3f(4, 0, -4);
    glVertex3f(4, 0, 4);
    glVertex3f(-4, 0, 4);

    // Back wall, z = -4.
    glNormal3f(0, 0, 1);
    glVertex3f(-4, 0, -4);
    glVertex3f(4, 0, -4);
    glVertex3f(4, 6, -4);
    glVertex3f(-4, 6, -4);

    // Left wall, x = -4.
    glNormal3f(1, 0, 0);
    glVertex3f(-4, 0, 4);
    glVertex3f(-4, 0, -4);
    glVertex3f(-4, 6, -4);
    glVertex3f(-4, 6, 4);
  glEnd();
}

cube() {
  glBegin(GL_QUADS);
    // Front (+Z).
    glNormal3f(0, 0, 1);
    glVertex3f(-1, 0, 1);
    glVertex3f(1, 0, 1);
    glVertex3f(1, 2, 1);
    glVertex3f(-1, 2, 1);

    // Back (-Z).
    glNormal3f(0, 0, -1);
    glVertex3f(1, 0, -1);
    glVertex3f(-1, 0, -1);
    glVertex3f(-1, 2, -1);
    glVertex3f(1, 2, -1);

    // Left (-X).
    glNormal3f(-1, 0, 0);
    glVertex3f(-1, 0, -1);
    glVertex3f(-1, 0, 1);
    glVertex3f(-1, 2, 1);
    glVertex3f(-1, 2, -1);

    // Right (+X).
    glNormal3f(1, 0, 0);
    glVertex3f(1, 0, 1);
    glVertex3f(1, 0, -1);
    glVertex3f(1, 2, -1);
    glVertex3f(1, 2, 1);

    // Top (+Y).
    glNormal3f(0, 1, 0);
    glVertex3f(-1, 2, -1);
    glVertex3f(-1, 2, 1);
    glVertex3f(1, 2, 1);
    glVertex3f(1, 2, -1);

    // Bottom (-Y).
    glNormal3f(0, -1, 0);
    glVertex3f(-1, 0, -1);
    glVertex3f(1, 0, -1);
    glVertex3f(1, 0, 1);
    glVertex3f(-1, 0, 1);
  glEnd();
}

// Project the same cube onto each receiver plane. These are the general
// dot*identity - light*plane matrices specialized for y=0, z=-4 and x=-4.
// The projected pixels write stencil rather than color, so overlapping
// receiver shadows remain one mask.
shadowMask() {
  // Floor: plane (0, 1, 0, 0).
  glPushMatrix();
    glMultMatrixf((GLfloat[]){ly, 0, 0, 0, -lx, 0, -lz, -1, 0, 0, ly, 0, 0, 0, 0, ly});
    cube();
  glPopMatrix();

  // Back wall: plane (0, 0, 1, 4).
  glPushMatrix();
    glMultMatrixf((GLfloat[]){lz + 4, 0, 0, 0, 0, lz + 4, 0, 0, -lx, -ly, 4, -1, -4*lx, -4*ly, -4*lz, lz});
    cube();
  glPopMatrix();

  // Left wall: plane (1, 0, 0, 4).
  glPushMatrix();
    glMultMatrixf((GLfloat[]){4, -ly, -lz, -1, 0, lx + 4, 0, 0, 0, 0, lx + 4, 0, -4*lx, -4*ly, -4*lz, lx});
    cube();
  glPopMatrix();
}
display() {

glTranslatef(0, 0, -12.5); // @camera dist
glRotatef(22, 1, 0, 0); // @camera rx
glRotatef(-28, 0, 1, 0); // @camera ry
glTranslatef(0, -0.8, 0); // @camera pan

glClearColor(0.05, 0.06, 0.08, 1);
glClearStencil(0);
glClear(GL_COLOR_BUFFER_BIT | GL_DEPTH_BUFFER_BIT | GL_STENCIL_BUFFER_BIT);
glEnable(GL_DEPTH_TEST);
glEnable(GL_NORMALIZE);
glShadeModel(GL_SMOOTH);

// The virtual lamp follows the same pattern as the planar-shadow example:
// expressions update both the marker and the generated shadow every frame.
lx = 3.5*cos(0.45*t);
ly = 3.5 + sin(0.32*t);
lz = 2.8*sin(0.50*t + 0.80);

// Pass 1: an unlit base establishes the depth buffer everywhere the room
// and cube are visible. The later lit pass is depth-equal to this pass.
glDisable(GL_STENCIL_TEST);
glDisable(GL_LIGHTING);
glDepthFunc(GL_LESS);
glDepthMask(GL_TRUE);
glColor3f(0.28 * 0.10, 0.28 * 0.95, 0.28 * 0.85);
room();
glColor3f(0.20 * 1.00, 0.20 * 0.35, 0.20 * 0.20);
cube();

// Pass 2: the three moving planar projections replace stencil with 1 where
// they land on the already-filled receiver depth.
glColorMask(GL_FALSE, GL_FALSE, GL_FALSE, GL_FALSE);
glDepthMask(GL_FALSE);
glEnable(GL_STENCIL_TEST);
glStencilMask(0xFF);
glStencilFunc(GL_ALWAYS, 1, 0xFF);
glStencilOp(GL_KEEP, GL_KEEP, GL_REPLACE);
glDisable(GL_LIGHTING);
glDepthFunc(GL_LEQUAL);
glEnable(GL_POLYGON_OFFSET_FILL);
glPolygonOffset(-1, -1);
shadowMask();
glDisable(GL_POLYGON_OFFSET_FILL);
glDepthFunc(GL_LESS);
glColorMask(GL_TRUE, GL_TRUE, GL_TRUE, GL_TRUE);
glDepthMask(GL_TRUE);
glStencilOp(GL_KEEP, GL_KEEP, GL_KEEP);

// Pass 3: paint the bright scene only where the stencil count is zero. This
// emulates illumination from the virtual lamp without a movable glLightfv.
glDisable(GL_LIGHTING);
glStencilFunc(GL_EQUAL, 0, 0xFF);
glStencilOp(GL_KEEP, GL_KEEP, GL_KEEP);
glDepthFunc(GL_EQUAL);
glDepthMask(GL_FALSE);
glColor3f(0.10, 0.95, 0.85);
room();
glColor3f(1.00, 0.35, 0.20);
cube();
glDepthMask(GL_TRUE);
glDepthFunc(GL_LESS);

// A second stencil-tested pass makes the shadow readable on the floor and
// both walls without relying on a screen-space projection matrix.
glStencilFunc(GL_NOTEQUAL, 0, 0xFF);
glDisable(GL_LIGHTING);
glEnable(GL_BLEND);
glBlendFunc(GL_SRC_ALPHA, GL_ONE_MINUS_SRC_ALPHA);
glDepthFunc(GL_EQUAL);
glDepthMask(GL_FALSE);
glColor4f(0.05, 0.06, 0.08, 0.38);
room();
glDisable(GL_BLEND);
glDepthMask(GL_TRUE);
glDepthFunc(GL_LESS);
glDisable(GL_STENCIL_TEST);

// The marker makes the virtual light's orbit and the shadow response explicit.
glColor3f(1.00, 0.85, 0.15);
glPushMatrix();
  glTranslatef(lx, ly, lz);
  glutSolidSphere(0.14, 12, 10);
glPopMatrix();
}
