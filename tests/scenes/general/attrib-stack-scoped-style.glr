// @cfg grid = GRID_THEME_OFF
// @cfg vertex_points = 0
// @cfg vertex_outlines = 0
// Visual attrib-stack story. Five objects in a row:
//   1. lit teal teapot          -- baseline
//   2. unlit coral wire cube    -- after push, lighting off, LINE mode
//   3. amber point sphere       -- nested ALL_ATTRIB_BITS, POINT mode
//   4. violet wire torus        -- after inner pop, still in LINE mode
//   5. lit teal teapot          -- after outer pop, matches object 1
// If 1 and 5 disagree, a push/pop pair leaked.
static float bob;

glTranslatef(0.0f, 0.0f, -10.00f);   // @camera dist
glRotatef(16.0f, 1.0f, 0.0f, 0.0f);   // @camera rx
glRotatef(8.0f, 0.0f, 1.0f, 0.0f);   // @camera ry
glTranslatef(0.0f, 0.0f, 0.0f);   // @camera pan

glClearColor(0.05, 0.06, 0.08, 1);
glClear(GL_COLOR_BUFFER_BIT | GL_DEPTH_BUFFER_BIT);
glEnable(GL_DEPTH_TEST);
glEnable(GL_LIGHTING);
glEnable(GL_LIGHT0);
glEnable(GL_NORMALIZE);
glEnable(GL_COLOR_MATERIAL);
glColorMaterial(GL_FRONT_AND_BACK, GL_AMBIENT_AND_DIFFUSE);
glPolygonMode(GL_FRONT_AND_BACK, GL_FILL);
glLineWidth(1);
glPointSize(1);

bob = 0.12 * sin(t * 2.2);

// 1. Baseline lit teapot
glPushMatrix();
  glTranslatef(-3.2, bob, 0);
  glColor3f(0.10, 0.95, 0.85);
  glutSolidTeapot(0.55);
glPopMatrix();

glPushAttrib(GL_ENABLE_BIT | GL_LIGHTING_BIT | GL_POLYGON_BIT | GL_LINE_BIT | GL_POINT_BIT);

// 2. Mutate: unlit wireframe
glDisable(GL_LIGHTING);
glPolygonMode(GL_FRONT_AND_BACK, GL_LINE);
glLineWidth(2.4);
glColor3f(1.00, 0.35, 0.20);
glPushMatrix();
  glTranslatef(-1.6, -bob, 0);
  glRotatef(t * 25, 1, 1, 0);
  glutSolidCube(0.95);
glPopMatrix();

glPushAttrib(GL_ALL_ATTRIB_BITS);

// 3. Nested mutate: point cloud
glPolygonMode(GL_FRONT_AND_BACK, GL_POINT);
glPointSize(5);
glColor3f(1.00, 0.85, 0.15);
glPushMatrix();
  glTranslatef(0, bob, 0);
  glRotatef(t * 35, 0, 1, 1);
  glutSolidSphere(0.62, 14, 10);
glPopMatrix();

glPopAttrib();

// 4. Back in the LINE / unlit frame
glColor3f(0.55, 0.30, 1.00);
glPushMatrix();
  glTranslatef(1.6, -bob, 0);
  glRotatef(t * 20, 1, 0, 1);
  glutSolidTorus(0.16, 0.48, 12, 20);
glPopMatrix();

glPopAttrib();

// 5. Restored baseline -- must match object 1
glPushMatrix();
  glTranslatef(3.2, bob, 0);
  glColor3f(0.10, 0.95, 0.85);
  glutSolidTeapot(0.55);
glPopMatrix();
