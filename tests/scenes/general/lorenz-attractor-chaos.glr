// @cfg grid = GRID_THEME_OFF
// @cfg vertex_points = 0
// @cfg vertex_outlines = 0
// Numerical integration of the classic Lorenz strange attractor.
// A continuous line strip traces the twin butterfly lobes with a
// neon gradient, while a glowing bead orbits along the trajectory.
static float x, y, z, dx, dy, dz;
static float dt, scale, u, cur_step;
static float hx, hy, hz;

display() {
  glTranslatef(0.0000f, 0.0000f, -8.5000f);   // @camera dist
  glRotatef(22.0000f, 1.0f, 0.0f, 0.0f);   // @camera rx
  glRotatef(45.0000f, 0.0f, 1.0f, 0.0f);   // @camera ry
  glTranslatef(0.0000f, 0.0000f, 0.0000f);   // @camera pan

  glClearColor(0.05, 0.06, 0.08, 1);
  glClear(GL_COLOR_BUFFER_BIT | GL_DEPTH_BUFFER_BIT);
  glEnable(GL_DEPTH_TEST);

  glRotatef(t * 12, 0, 1, 0);

  x = 0.1;
  y = 0.0;
  z = 0.0;
  dt = 0.016;
  scale = 0.11;
  cur_step = fmod(t * 40, 200);

  glLineWidth(1.8);
  glBegin(GL_LINE_STRIP);
    for(i, 0, 200) {
      dx = 10.0 * (y - x) * dt;
      dy = (x * (28.0 - z) - y) * dt;
      dz = (x * y - 2.6667 * z) * dt;

      x = x + dx;
      y = y + dy;
      z = z + dz;

      u = i / 199.0;
      // Neon gradient sweep: Violet -> Azure -> Teal -> Amber
      glColor3f(0.55 + 0.45 * sin(u * PI), 0.30 + 0.65 * u, 1.00 - 0.85 * u);
      glVertex3f(x * scale, (z - 25.0) * scale, y * scale);
    }
  glEnd();

  // Trace to locate current animated head position
  x = 0.1;
  y = 0.0;
  z = 0.0;
  for(i, 0, 200) {
    if(i <= cur_step) {
      dx = 10.0 * (y - x) * dt;
      dy = (x * (28.0 - z) - y) * dt;
      dz = (x * y - 2.6667 * z) * dt;
      x = x + dx;
      y = y + dy;
      z = z + dz;
      hx = x * scale;
      hy = (z - 25.0) * scale;
      hz = y * scale;
    }
  }

  // Glowing head beacon
  glEnable(GL_LIGHTING);
  glEnable(GL_LIGHT0);
  glEnable(GL_COLOR_MATERIAL);
  glColorMaterial(GL_FRONT_AND_BACK, GL_AMBIENT_AND_DIFFUSE);

  glPushMatrix();
    glTranslatef(hx, hy, hz);
    glColor3f(1.00, 0.85, 0.15);
    glutSolidSphere(0.12, 16, 12);
  glPopMatrix();

  glDisable(GL_LIGHTING);
  glColor3f(0.92, 0.95, 0.98);
  glRasterPos3f(-3.2, 2.3, 0);
  label("Lorenz Attractor - sigma 10 rho 28 beta 2.67");
  glRasterPos3f(-3.2, 2.0, 0);
  label("Head: x=%f  y=%f  z=%f", x, y, z);
}
