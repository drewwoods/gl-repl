// @cfg grid = GRID_THEME_OFF
// @cfg view_mode = RENDER3D_VIEW_2D
display() {
  glTranslatef(0.0000f, 0.0000f, -6.0000f);   // @camera dist
  glRotatef(0.0000f, 1.0f, 0.0f, 0.0f);   // @camera rx
  glRotatef(0.0000f, 0.0f, 1.0f, 0.0f);   // @camera ry
  glTranslatef(-0.0000f, -0.0000f, -0.0000f);   // @camera pan

  // Clear screen to Canvas color
  glClearColor(0.05, 0.06, 0.08, 1);
  glClear(GL_COLOR_BUFFER_BIT | GL_DEPTH_BUFFER_BIT);

  glEnable(GL_LINE_STIPPLE);
  glDisable(GL_LINE_SMOOTH); // Affects stipple on macOS
  glLineWidth(2.5);

  // Pattern 1: Dot-dash (e.g. 0x5555 -> 21845)
  glLineStipple(1, 21845);
  glColor3f(0.1, 0.95, 0.85); // TEAL
  glBegin(GL_LINES);
    glVertex3f(-2.5, 1.5, 0);
    glVertex3f(2.5, 1.5, 0);
  glEnd();

  // Pattern 2: Dashed (0x0F0F -> 3855) with factor 2
  glLineStipple(2, 3855);
  glColor3f(1, 0.85, 0.15); // AMBER
  glBegin(GL_LINES);
    glVertex3f(-2.5, 0.5, 0);
    glVertex3f(2.5, 0.5, 0);
  glEnd();

  // Pattern 3: Long dashes (0x00FF -> 255) with factor 3
  glLineStipple(3, 255);
  glColor3f(0.95, 0.25, 1); // MAGENTA
  glBegin(GL_LINES);
    glVertex3f(-2.5, -0.5, 0);
    glVertex3f(2.5, -0.5, 0);
  glEnd();

  // Pattern 4: Alternating dots (0xAAAA -> 43690) with factor 4
  glLineStipple(4, 43690);
  glColor3f(0.55, 0.3, 1); // VIOLET
  glBegin(GL_LINES);
    glVertex3f(-2.5, -1.5, 0);
    glVertex3f(2.5, -1.5, 0);
  glEnd();

  glDisable(GL_LINE_STIPPLE);
  glLineWidth(1);
}
