// @cfg view_mode = RENDER3D_VIEW_3D
// @cfg axes = AXES_THEME_OFF
// @cfg grid = GRID_THEME_CLASSIC

static float count = 220;
static float rad, arm, angle, px, py, pz;
static float r, g, b_col, alpha;

glTranslatef(0.0000f, 0.0000f, -8.0000f);   // @camera dist
glRotatef(30.0000f, 1.0f, 0.0f, 0.0f);   // @camera rx
glRotatef(0.0000f, 0.0f, 1.0f, 0.0f);   // @camera ry
glTranslatef(0.0000f, 0.0000f, 0.0000f);   // @camera pan

glClearColor(0.02, 0.02, 0.04, 1.0);
glClear(GL_COLOR_BUFFER_BIT | GL_DEPTH_BUFFER_BIT);
glEnable(GL_DEPTH_TEST);
glEnable(GL_BLEND);
glBlendFunc(GL_SRC_ALPHA, GL_ONE);

glPointSize(5.0);

glPushMatrix();
glRotatef(t * 15.0, 0, 1, 0); // slowly spin galaxy

glBegin(GL_POINTS);
  for(i, 0, count) {
    rad = 0.1 + 3.2 * (i / count);
    arm = fmod(i, 2.0); // 2 arms

    // Spiral angle + rotation over time
    angle = rad * 2.2 - t * 1.0 + arm * PI;

    // Distort a bit with a deterministic noise based on i
    px = rad * cos(angle) + sin(i * 14.3) * 0.12;
    pz = rad * sin(angle) + cos(i * 14.3) * 0.12;
    py = cos(rad * 3.0 - t * 2.0) * 0.12 * (3.5 - rad);

    // Color interpolation: core is hot yellow-white, arms are cyan/magenta
    r = lerp(1.0, 0.3 + 0.7 * sin(rad * 2.0 + t), rad / 3.2);
    g = lerp(0.9, 0.2 + 0.5 * cos(rad * 1.5 - t), rad / 3.2);
    b_col = lerp(0.5, 0.95, rad / 3.2);

    alpha = 1.0 - (rad / 3.5);
    if (alpha < 0.15) {
      alpha = 0.15;
    }

    glColor4f(r, g, b_col, alpha);
    glVertex3f(px, py, pz);
  }
glEnd();

glPopMatrix();
glDisable(GL_BLEND);
