// @cfg grid = GRID_THEME_TRON
// @cfg grid_brightness = GRID_BRIGHTNESS_DIM
static float grid_x = 7;
static float grid_z = 7;
static float spacing = 0.8;
static float start_x, start_z, x, z, dist, h;
display() {
  glTranslatef(0.0000f, 0.0000f, -8.5000f);   // @camera dist
  glRotatef(30.0000f, 1.0f, 0.0f, 0.0f);   // @camera rx
  glRotatef(0.0000f, 0.0f, 1.0f, 0.0f);   // @camera ry
  glTranslatef(-0.0000f, -0.0000f, -0.0000f);   // @camera pan


  glClearColor(0.05, 0.06, 0.09, 1);
  glClear(GL_COLOR_BUFFER_BIT | GL_DEPTH_BUFFER_BIT);
  glEnable(GL_DEPTH_TEST);
  glEnable(GL_LIGHTING);
  glEnable(GL_LIGHT0);

  start_x = -(grid_x - 1) * spacing * 0.5;
  start_z = -(grid_z - 1) * spacing * 0.5;

  for(ix, 0, grid_x) {
    for(iz, 0, grid_z) {
      x = start_x + ix * spacing;
      z = start_z + iz * spacing;

      dist = sqrt(x * x + z * z);
      h = 0.6 + 0.5 * sin(dist * 2.0 - t * 3.0);

      glPushMatrix();
        glTranslatef(x, h * 0.5, z);
        glScalef(0.5, h, 0.5);

        if(h > 0.85) {
          glMaterialfv(GL_FRONT_AND_BACK, GL_DIFFUSE, (GLfloat[]){0.9, 0.2, 0.3, 1});
        } else if(h > 0.6) {
          glMaterialfv(GL_FRONT_AND_BACK, GL_DIFFUSE, (GLfloat[]){0.9, 0.7, 0.2, 1});
        } else {
          glMaterialfv(GL_FRONT_AND_BACK, GL_DIFFUSE, (GLfloat[]){0.2, 0.6, 0.9, 1});
        }
        glutSolidCube(1);
      glPopMatrix();
    }
  }
}
