// @cfg grid = GRID_THEME_PLANES
// @cfg view_mode = RENDER3D_VIEW_2D
// @cfg vertex_labels = OVERLAY_VERTEX_LABEL_OFF
// @cfg vertex_points = 0
// @cfg vertex_outlines = 0
// @cfg polygon_highlight = 0
// Bubble sort across up to 3 scratch arrays (A, B, C for 16-48 elements),
// scrubbed by t. The nested loops run compare-and-swap, but each pass p only
// compares the unsorted prefix (0..count-1-p) since elements bubbled to the
// right are static and in their final sorted positions. Every frame re-seeds
// and re-sorts up to floor(steps) compares -- drag the time slider or replay
// to scrub the sort.

static float count = 32; // number of bars to sort (16-48) @tune @config
static float rate = 45; // compare steps per second @tune
static float hold = 1.5; // seconds to rest on the sorted bars @tune
static float totalSteps, period, cycle, steps;
static float step, cur, curPass;
static float tmp, s, x, h, k;
static float barWidth, barHalf;

// Compare and swap adjacent elements at j and j+1 across A, B, C
compareAndSwap(j) {
  // Elements both in A (0..15)
  if(j < 15) {
    if(A[j] > A[j+1]) {
      tmp = A[j];
      A[j] = A[j+1];
      A[j+1] = tmp;
    }
  } else if(j == 15) {
    // Boundary between A and B
    if(A[15] > B[0]) {
      tmp = A[15];
      A[15] = B[0];
      B[0] = tmp;
    }
  } else if(j < 31) {
    // Elements both in B (16..31)
    k = max(0, j - 16);
    if(B[k] > B[k+1]) {
      tmp = B[k];
      B[k] = B[k+1];
      B[k+1] = tmp;
    }
  } else if(j == 31) {
    // Boundary between B and C
    if(B[15] > C[0]) {
      tmp = B[15];
      B[15] = C[0];
      C[0] = tmp;
    }
  } else {
    // Elements both in C (32..47)
    k = max(0, j - 32);
    if(C[k] > C[k+1]) {
      tmp = C[k];
      C[k] = C[k+1];
      C[k+1] = tmp;
    }
  }
}

display() {

  glTranslatef(0.0000f, 0.0000f, -8.5000f);   // @camera dist
  glRotatef(0.0000f, 1.0f, 0.0f, 0.0f);   // @camera rx
  glRotatef(0.0000f, 0.0f, 1.0f, 0.0f);   // @camera ry
  glTranslatef(-0.0000f, -0.0000f, -0.0000f);   // @camera pan

  count = clamp(round(count), 16, 48);
  totalSteps = count*(count - 1)*0.5;
  period = totalSteps/rate + hold;
  cycle = floor(t/period);
  steps = fmod(t, period)*rate;

  // --- Render State -------------------
  glClearColor(0.05, 0.06, 0.08, 1);
  glClear(GL_COLOR_BUFFER_BIT | GL_DEPTH_BUFFER_BIT);
  glEnable(GL_DEPTH_TEST);
  glEnable(GL_POINT_SMOOTH);

  // --- Scene Geometry -----------------

  // A fresh deterministic shuffle across scratch arrays A, B, C
  for(i, 0, count) {
    if(i < 16) {
      A[i] = rand(i, cycle);
    } else if(i < 32) {
      k = max(0, i - 16);
      B[k] = rand(i, cycle);
    } else {
      k = max(0, i - 32);
      C[k] = rand(i, cycle);
    }
  }

  // Pass p bubbles the largest unsorted value to the right;
  // elements at the end are already sorted so each pass stops at count-1-p
  step = 0;
  cur = 0;
  curPass = 0;
  for(p, 0, count - 1) {
    for(j, 0, count - 1 - p) {
      if(step < steps) {
        compareAndSwap(j);
      }
      if(step == floor(steps)) {
        cur = j;
        curPass = p;
      }
      step = step + 1;
    }
  }

  barWidth = 6.4/count;
  barHalf = barWidth*0.36;

  // Bars: height and color both follow the value, so sorted reads as a
  // staircase with a smooth left-to-right gradient
  glBegin(GL_QUADS);
    for(i, 0, count) {
      if(i < 16) {
        s = A[i];
      } else if(i < 32) {
        k = max(0, i - 16);
        s = B[k];
      } else {
        k = max(0, i - 32);
        s = C[k];
      }
      glColor3f(1 - 0.85*s, 0.35 + 0.2*s, 0.2 + 0.8*s); // CORAL -> AZURE
      x = (i - (count - 1)*0.5)*barWidth;
      h = 0.3 + 2.4*s;
      glVertex3f(x - barHalf, -1.5, 0);
      glVertex3f(x + barHalf, -1.5, 0);
      glVertex3f(x + barHalf, -1.5 + h, 0);
      glVertex3f(x - barHalf, -1.5 + h, 0);
    }
  glEnd();

  if(steps < totalSteps) {
    // Two dots mark the pair the sort is comparing right now
    glPointSize(7);
    glColor3f(1, 0.85, 0.15);
    glBegin(GL_POINTS);
      glVertex3f((cur - (count - 1)*0.5)*barWidth, -1.75, 0);
      glVertex3f((cur + 1 - (count - 1)*0.5)*barWidth, -1.75, 0);
    glEnd();
    glColor3f(0.92, 0.95, 0.98);
    glRasterPos3f(-3.4, 1.7, 0);
    label("pass %f of %f", curPass + 1, count - 1);
  } else {
    glColor3f(0.92, 0.95, 0.98);
    glRasterPos3f(-3.4, 1.7, 0);
    label("sorted");
  }
}
