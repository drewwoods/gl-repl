// @cfg grid = GRID_THEME_TRON
// @cfg grid_brightness = GRID_BRIGHTNESS_DIM
// @cfg light_theme = LIGHT_THEME_HEADLIGHT
// camera
glTranslatef(0.0f, 0.0f, -6.00f);
glRotatef(10.0f, 1.0f, 0.0f, 0.0f);
glRotatef(15.0f, 0.0f, 1.0f, 0.0f);
glTranslatef(0.0f, 0.0f, 0.0f);
glClear(GL_COLOR_BUFFER_BIT | GL_DEPTH_BUFFER_BIT);
glEnable(GL_COLOR_MATERIAL);
glColorMaterial(GL_FRONT_AND_BACK, GL_AMBIENT_AND_DIFFUSE);
glLightModeli(GL_LIGHT_MODEL_TWO_SIDE, GL_TRUE);
glMaterialfv(GL_FRONT_AND_BACK, GL_SPECULAR, (GLfloat[]){0.4, 0.4, 0.4, 1.0});
glMaterialf(GL_FRONT_AND_BACK, GL_SHININESS, 30);

glClearColor(0.05, 0.06, 0.08, 1.0);
glEnable(GL_DEPTH_TEST);
glEnable(GL_LIGHTING);
glEnable(GL_NORMALIZE);
glEnable(GL_LIGHT3);
glEnable(GL_LIGHT2);
glEnable(GL_LIGHT0);
glShadeModel(GL_SMOOTH);
glFrontFace(GL_CW);
glRotatef(10*t, 0, 0, 1);
// Same concave arrow as the previous example, plus a second contour: a
// smaller arrow traced inside the first. The tessellator's default odd
// winding rule fills a point only when it sits inside an odd number of
// contours, so the inner contour punches a hole.
gluBegin(GLU_POLYGON);
gluBegin(GLU_CONTOUR);
gluNormal(0, 0, 1);
gluColor(0.15, 0.55, 1, 1);
gluVertex(-1.2, -0.45, 0);
gluColor(0.15, 0.55, 1, 1);
gluVertex(-1.2, 0.45, 0);
gluColor(0.55, 0.3, 1, 1);
gluVertex(0, 0.45, 0);
gluColor(1, 0.35, 0.2, 1);
gluVertex(0, 1.1, 0);
gluColor(1, 0.85, 0.15, 1);
gluVertex(1.3, 0, 0);
gluColor(1, 0.35, 0.2, 1);
gluVertex(0, -1.1, 0);
gluColor(0.55, 0.3, 1, 1);
gluVertex(0, -0.45, 0);
gluEnd();
// Inner contour = the cutout. Grey so the hole edge reads against the
// colored face.
gluBegin(GLU_CONTOUR);
gluColor(0.45, 0.49, 0.58, 1);
gluVertex(-0.6, -0.225, 0);
gluVertex(-0.6, 0.225, 0);
gluVertex(0.2, 0.225, 0);
gluVertex(0.2, 0.55, 0);
gluVertex(0.85, 0, 0);
gluVertex(0.2, -0.55, 0);
gluVertex(0.2, -0.225, 0);
gluEnd();
gluEnd();
