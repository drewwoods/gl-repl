// @cfg overlay_scope = OVERLAY_SCOPE_ALL_INSTANCES
// @cfg vertex_label_placement = OVERLAY_LABEL_PLACEMENT_AT_VERTEX

static float s; // color mix factor, 0..1

glTranslatef(0.0f, 0.0f, -6.00f);   // @camera dist
glRotatef(24.0f, 1.0f, 0.0f, 0.0f);   // @camera rx
glRotatef(43.0f, 0.0f, 1.0f, 0.0f);   // @camera ry
glTranslatef(0.0f, 0.0f, 0.0f);   // @camera pan

glClearColor(0.05, 0.06, 0.08, 1.0);
glClear(GL_COLOR_BUFFER_BIT | GL_DEPTH_BUFFER_BIT);

glEnable(GL_DEPTH_TEST);
glBegin(GL_LINE_LOOP);
  for(i, 0, 48) {
    s = sin(i*TAU/48)*0.5 + 0.5;
    glColor3f(1 - 0.85*s, 0.35 + 0.2*s, 0.2 + 0.8*s); // CORAL -> AZURE
    glVertex3f(cos(i*TAU/48+t)*2, sin(i*TAU/48+t)*2, sin(i*TAU/12+t)*0.5);
  }
glEnd();
glBegin(GL_TRIANGLE_FAN);
  glColor3f(0.92, 0.95, 0.98);
  glVertex3f(0, 0, 0);
  for(i, 0, 25) {
    s = sin(i*TAU/24+t)*0.5 + 0.5;
    glColor3f(1 - 0.85*s, 0.35 + 0.2*s, 0.2 + 0.8*s); // CORAL -> AZURE
    glVertex3f(cos(i*TAU/24)*1.5, sin(i*TAU/24)*1.5, 0);
  }
glEnd();
