display() {
  glTranslatef(0.0000f, 0.0000f, -6.0000f);   // @camera dist
  glRotatef(20.0000f, 1.0f, 0.0f, 0.0f);   // @camera rx
  glRotatef(35.0000f, 0.0f, 1.0f, 0.0f);   // @camera ry
  glTranslatef(-0.0000f, -0.0000f, -0.0000f);   // @camera pan
  // --- Render State -------------------
  glClearColor(0.05, 0.06, 0.08, 1);
  glClear(GL_COLOR_BUFFER_BIT | GL_DEPTH_BUFFER_BIT);
  glEnable(GL_DEPTH_TEST);

  // --- Scene Geometry -----------------
  // Flat conditional colors: no GL_LIGHTING here, so glColor is shown
  // verbatim (no normals / lights needed to see the if/else at work).
  glBegin(GL_QUADS);
    if(sin(t) > 0) {
      glColor3f(1, 0.35, 0.2);
    } else {
      glColor3f(0.15, 0.55, 1);
    }
    glVertex3f(-1, -1, 0);
    glVertex3f(1, -1, 0);
    glVertex3f(1, 1, 0);
    glVertex3f(-1, 1, 0);
    if(cos(t) > 0) {
      glColor3f(0.1, 0.95, 0.85);
    } else {
      glColor3f(1, 0.85, 0.15);
    }
    glVertex3f(-1, -1, -1);
    glVertex3f(-1, 1, -1);
    glVertex3f(1, 1, -1);
    glVertex3f(1, -1, -1);
  glEnd();
}
