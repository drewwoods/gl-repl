// camera
glTranslatef(0.0f, 0.0f, -6.00f);
glRotatef(20.0f, 1.0f, 0.0f, 0.0f);
glRotatef(35.0f, 0.0f, 1.0f, 0.0f);
glTranslatef(0.0f, 0.0f, 0.0f);
glClearColor(0.05, 0.06, 0.08, 1.0);
glEnable(GL_DEPTH_TEST);
// Flat conditional colors: no GL_LIGHTING here, so glColor is shown
// verbatim (no normals / lights needed to see the if/else at work).
glBegin(GL_QUADS);
  if(sin(t) > 0) {
    glColor3f(0.98, 0.46, 0.36);
  } else {
    glColor3f(0.36, 0.70, 0.98);
  }
  glVertex3f(-1, -1, 0);
  glVertex3f(1, -1, 0);
  glVertex3f(1, 1, 0);
  glVertex3f(-1, 1, 0);
  if(cos(t) > 0) {
    glColor3f(0.30, 0.84, 0.80);
  } else {
    glColor3f(0.98, 0.76, 0.36);
  }
  glVertex3f(-1, -1, -1);
  glVertex3f(-1, 1, -1);
  glVertex3f(1, 1, -1);
  glVertex3f(1, -1, -1);
glEnd();
