// camera
glTranslatef(0.0f, 0.0f, -6.0f);
glRotatef(20.0f, 1.0f, 0.0f, 0.0f);
glRotatef(35.0f, 0.0f, 1.0f, 0.0f);
glTranslatef(0.0f, 0.0f, 0.0f);
glClearColor(0.1, 0.1, 0.1, 1.0);
glEnable(GL_DEPTH_TEST);
// Flat conditional colors: no GL_LIGHTING here, so glColor is shown
// verbatim (no normals / lights needed to see the if/else at work).
glBegin(GL_QUADS);
  if(sin(t) > 0) {
    glColor3f(1, 0.2, 0.2);
  } else {
    glColor3f(0.2, 0.2, 1);
  }
  glVertex3f(-1, -1, 0);
  glVertex3f(1, -1, 0);
  glVertex3f(1, 1, 0);
  glVertex3f(-1, 1, 0);
  if(cos(t) > 0) {
    glColor3f(0.2, 1, 0.2);
  } else {
    glColor3f(1, 1, 0.2);
  }
  glVertex3f(-1, -1, -1);
  glVertex3f(-1, 1, -1);
  glVertex3f(1, 1, -1);
  glVertex3f(1, -1, -1);
glEnd();
