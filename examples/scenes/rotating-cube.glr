// @cfg axes = AXES_THEME_OFF
// @cfg light_indicators = 1
// @cfg grid = GRID_THEME_CLASSIC
// @cfg light_theme = LIGHT_THEME_NEON
// @cfg grid_brightness = GRID_BRIGHTNESS_DIM
// --- Camera -------------------------
glTranslatef(0.0f, 0.0f, -9.00f);
glRotatef(12.0f, 1.0f, 0.0f, 0.0f);
glRotatef(92.0f, 0.0f, 1.0f, 0.0f);
glTranslatef(0.0f, 0.0f, 0.0f);

// --- Render State -------------------
glClearColor(0.05, 0.06, 0.08, 1);
glClear(GL_COLOR_BUFFER_BIT | GL_DEPTH_BUFFER_BIT);
glMaterialfv(GL_FRONT_AND_BACK, GL_DIFFUSE, (GLfloat[]){1, 1, 1, 1});
glMaterialfv(GL_FRONT_AND_BACK, GL_SPECULAR, (GLfloat[]){0.4, 0.4, 0.4, 1});
glMaterialf(GL_FRONT_AND_BACK, GL_SHININESS, 30);
glEnable(GL_DEPTH_TEST);

// --- Lighting -----------------------
glEnable(GL_LIGHTING);
glEnable(GL_LIGHT3);
glEnable(GL_LIGHT2);
glEnable(GL_LIGHT1);
glEnable(GL_LIGHT0);

// --- Scene Geometry -----------------
glRotatef(40*t, 0, 1, 0);
glutSolidCube(2);
