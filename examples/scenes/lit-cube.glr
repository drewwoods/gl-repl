// camera
glTranslatef(0.0f, 0.0f, -6.0f);
glRotatef(20.0f, 1.0f, 0.0f, 0.0f);
glRotatef(35.0f, 0.0f, 1.0f, 0.0f);
glTranslatef(0.0f, 0.0f, 0.0f);

glClearColor(0.1, 0.1, 0.1, 1.0);
glEnable(GL_DEPTH_TEST);
glEnable(GL_LIGHTING);
glEnable(GL_NORMALIZE);
glShadeModel(GL_SMOOTH);
glEnable(GL_LIGHT3);
glEnable(GL_LIGHT2);
glColor3f(1, 1, 1);
// A lit unit cube: all six faces, each with one outward-pointing normal so
// the lights face it crisply (one normal per face -> flat-lit faces).
glBegin(GL_QUADS);
  // +X face
  glNormal3f(1, 0, 0);
  glVertex3f(1, -1, -1);
  glVertex3f(1, 1, -1);
  glVertex3f(1, 1, 1);
  glVertex3f(1, -1, 1);
  // -X face
  glNormal3f(-1, 0, 0);
  glVertex3f(-1, -1, 1);
  glVertex3f(-1, 1, 1);
  glVertex3f(-1, 1, -1);
  glVertex3f(-1, -1, -1);
  // +Y face
  glNormal3f(0, 1, 0);
  glVertex3f(-1, 1, 1);
  glVertex3f(1, 1, 1);
  glVertex3f(1, 1, -1);
  glVertex3f(-1, 1, -1);
  // -Y face
  glNormal3f(0, -1, 0);
  glVertex3f(-1, -1, -1);
  glVertex3f(1, -1, -1);
  glVertex3f(1, -1, 1);
  glVertex3f(-1, -1, 1);
  // +Z face
  glNormal3f(0, 0, 1);
  glVertex3f(-1, -1, 1);
  glVertex3f(1, -1, 1);
  glVertex3f(1, 1, 1);
  glVertex3f(-1, 1, 1);
  // -Z face
  glNormal3f(0, 0, -1);
  glVertex3f(1, -1, -1);
  glVertex3f(-1, -1, -1);
  glVertex3f(-1, 1, -1);
  glVertex3f(1, 1, -1);
glEnd();
