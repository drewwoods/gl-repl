// @cfg grid_brightness = GRID_BRIGHTNESS_DIM
// @cfg light_theme = LIGHT_THEME_HEADLIGHT
// @cfg vertex_points = 0
// @cfg projection = PROJ_ORTHO
// @cfg wireframe = WIREFRAME_HIDDEN
// @cfg accum_passes = 2
// @cfg grid = GRID_THEME_OFF

// camera
glTranslatef(0.0f, 0.0f, -6.00f);
glRotatef(35.25f, 1.0f, 0.0f, 0.0f);
glRotatef(45.0f, 0.0f, 1.0f, 0.0f);
glTranslatef(0.0f, 0.0f, 0.0f);

glClearColor(0.05, 0.06, 0.08, 1);
glEnable(GL_DEPTH_TEST);
glEnable(GL_LIGHTING);
glEnable(GL_NORMALIZE);
glShadeModel(GL_SMOOTH);
glEnable(GL_LIGHT0);

// An open cube with distinct front and back colors.
// Normals are defined per-face for crisp, flat-lit lighting.
glColorMaterial(GL_BACK, GL_AMBIENT_AND_DIFFUSE);
glColor3f(0.36, 0.70, 0.98);
glColorMaterial(GL_FRONT, GL_AMBIENT_AND_DIFFUSE);
glColor3f(0.92, 0.95, 0.98);
glBegin(GL_QUADS);
  glNormal3f(0, 1, 0);
  glVertex3f(-1, 1, 1);
  glVertex3f(1, 1, 1);
  glVertex3f(1, 1, -1);
  glVertex3f(-1, 1, -1);
  // -Y face
  glNormal3f(0, -1, 0);
  glVertex3f(-1, -1, -1);
  glVertex3f(1, -1, -1);
  glVertex3f(1, -1, 1);
  glVertex3f(-1, -1, 1);
  // +Z face
  glNormal3f(0, 0, 1);
  glVertex3f(-1, -1, 1);
  glVertex3f(1, -1, 1);
  glVertex3f(1, 1, 1);
  glVertex3f(-1, 1, 1);
  // -Z face
  glNormal3f(0, 0, -1);
  glVertex3f(1, -1, -1);
  glVertex3f(-1, -1, -1);
  glVertex3f(-1, 1, -1);
  glVertex3f(1, 1, -1);
glEnd();
