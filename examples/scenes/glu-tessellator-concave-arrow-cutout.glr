// @cfg grid = GRID_THEME_TRON
// @cfg grid_brightness = GRID_BRIGHTNESS_DIM
// @cfg light_theme = LIGHT_THEME_HEADLIGHT
// camera
glTranslatef(0.0f, 0.0f, -6.0f);
glRotatef(10.0f, 1.0f, 0.0f, 0.0f);
glRotatef(15.0f, 0.0f, 1.0f, 0.0f);
glTranslatef(0.0f, 0.0f, 0.0f);

static float z;
glClearColor(0.05, 0.06, 0.08, 1.0);
glEnable(GL_DEPTH_TEST);
glEnable(GL_LIGHTING);
glEnable(GL_NORMALIZE);
glEnable(GL_LIGHT3);
glEnable(GL_LIGHT2);
glEnable(GL_LIGHT0);
glShadeModel(GL_SMOOTH);
glFrontFace(GL_CW);
z = -0.55;
glRotatef(10*t, 0, 0, 1);
// glScalef(0.5, 0.5, 0.5);
// Arrow shape - concave, tessellated with per-vertex color
gluBegin(GLU_POLYGON);
gluBegin(GLU_CONTOUR);
glBegin(GL_QUAD_STRIP);
  gluNormal(0, 0, 1);
  // Side 0
  gluColor(0.36, 0.70, 0.98, 1);
  glColor3f(0.36, 0.70, 0.98);
  glNormal3f(-1, 0, 0);
  glVertex3f(-1.2, -0.45, 0);
  glVertex3f(-1.2, -0.45, z);
  gluVertex(-1.2, -0.45, 0);
  // Side 1
  gluColor(0.36, 0.70, 0.98, 1);
  glColor3f(0.36, 0.70, 0.98);
  glNormal3f(0, 1, 0);
  glVertex3f(-1.2, 0.45, 0);
  glVertex3f(-1.2, 0.45, z);
  gluVertex(-1.2, 0.45, 0);
  // Side 2
  gluColor(0.62, 0.52, 0.95, 1);
  glColor3f(0.62, 0.52, 0.95);
  glNormal3f(-1, 1, 0);
  glVertex3f(0, 0.45, 0);
  glVertex3f(0, 0.45, z);
  gluVertex(0, 0.45, 0);
  // Side 3
  gluColor(0.98, 0.46, 0.36, 1);
  glColor3f(0.98, 0.46, 0.36);
  glNormal3f(-1, 0, 0);
  glVertex3f(0, 1.1, 0);
  glVertex3f(0, 1.1, z);
  gluVertex(0, 1.1, 0);
  // Side 4
  gluColor(0.98, 0.76, 0.36, 1);
  glColor3f(0.98, 0.76, 0.36);
  glNormal3f(1, 0, 0);
  glVertex3f(1.3, 0, 0);
  glVertex3f(1.3, 0, z);
  gluVertex(1.3, 0, 0);
  // Side 5
  gluColor(0.98, 0.46, 0.36, 1);
  glColor3f(0.98, 0.46, 0.36);
  glNormal3f(-1, 0, 0);
  glVertex3f(0, -1.1, 0);
  glVertex3f(0, -1.1, z);
  gluVertex(0, -1.1, 0);
  // Side 6
  gluColor(0.62, 0.52, 0.95, 1);
  glColor3f(0.62, 0.52, 0.95);
  glNormal3f(-1, -1, 0);
  glVertex3f(0, -0.45, 0);
  glVertex3f(0, -0.45, z);
  gluVertex(0, -0.45, 0);
  // Quade side 7
  glColor3f(0.36, 0.70, 0.98);
  glNormal3f(0, -1, 0);
  glVertex3f(-1.2, -0.45, 0);
  glVertex3f(-1.2, -0.45, z);
glEnd();
gluEnd();
gluBegin(GLU_CONTOUR);
glBegin(GL_QUAD_STRIP);
  glColor3f(0.45, 0.49, 0.58);
  gluNormal(0, 0, 1);
  // Side 0
  glNormal3f(-1, 0, 0);
  glVertex3f(-0.6, -0.225, 0);
  glVertex3f(-0.6, -0.225, z);
  gluVertex(-0.6, -0.225, 0);
  // Side 1
  glNormal3f(0, 1, 0);
  glVertex3f(-0.6, 0.225, 0);
  glVertex3f(-1.2/2, 0.45/2, z);
  gluVertex(-0.6, 0.225, 0);
  // Side 2
  glNormal3f(-1, 1, 0);
  glVertex3f(0.2, 0.225, 0);
  glVertex3f(0.2, 0.45/2, z);
  gluVertex(0.2, 0.225, 0);
  // Side 3
  glNormal3f(-1, 0, 0);
  glVertex3f(0.2, 0.55, 0);
  glVertex3f(0.2, 1.1/2, z);
  gluVertex(0.2, 0.55, 0);
  // Side 4
  glNormal3f(1, 0, 0);
  glVertex3f(0.85, 0, 0);
  glVertex3f(1.7/2, 0, z);
  gluVertex(0.85, 0, 0);
  // Side 5
  glNormal3f(-1, 0, 0);
  glVertex3f(0.2, -0.55, 0);
  glVertex3f(0.2, -1.1/2, z);
  gluVertex(0.2, -0.55, 0);
  // Side 6
  glNormal3f(-1, -1, 0);
  glVertex3f(0.2, -0.225, 0);
  glVertex3f(0.2, -0.45/2, z);
  gluVertex(0.2, -0.225, 0);
  // Quad side 7
  glNormal3f(0, -1, 0);
  glVertex3f(-0.6, -0.225, 0);
  glVertex3f(-1.2/2, -0.45/2, z);
glEnd();
gluEnd();
gluEnd();
