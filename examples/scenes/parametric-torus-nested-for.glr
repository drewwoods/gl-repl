// @cfg vertex_labels = 0
// camera
glTranslatef(0.0f, 0.0f, -8.00f);
glRotatef(20.0f, 1.0f, 0.0f, 0.0f);
glRotatef(35.0f, 0.0f, 1.0f, 0.0f);
glTranslatef(0.0f, 0.0f, 0.0f);
glEnable(GL_COLOR_MATERIAL);
glColorMaterial(GL_FRONT_AND_BACK, GL_AMBIENT_AND_DIFFUSE);
glLightModeli(GL_LIGHT_MODEL_TWO_SIDE, GL_TRUE);
glMaterialfv(GL_FRONT_AND_BACK, GL_SPECULAR, (GLfloat[]){0.4, 0.4, 0.4, 1.0});
glMaterialf(GL_FRONT_AND_BACK, GL_SHININESS, 30);

static float R = 2;  // major radius (ring center to tube center)
static float r = 1;  // minor radius (tube thickness)
static float n = 20; // segment count around both u and v
static float u, v, s; // current major/minor angles, color mix factor
glClearColor(0.05, 0.06, 0.08, 1.0);
glEnable(GL_DEPTH_TEST);
// Flat vertex-colored torus (no lighting): GL_SMOOTH still Gouraud-
// interpolates the per-vertex glColor gradient across each quad.
glShadeModel(GL_SMOOTH);
n = floor(n); // keep n an integer
n = min(20, max(n, 3)); // clamp to avoid exceeding cmd limit
for(i, 0, n) {
  glBegin(GL_QUAD_STRIP);
    for(j, 0, n+1) {
      // step v across the tube; emit two vertices, one at u=i and one at u=i+1
      v = j*TAU/n;
      u = i*TAU/n;
      s = 0.5 + 0.5 * sin(u + v);
      glColor3f(1 - 0.85*s, 0.35 + 0.2*s, 0.2 + 0.8*s); // CORAL -> AZURE
      glVertex3f((R + r*cos(v))*cos(u), (R + r*cos(v))*sin(u), r*sin(v));
      u = (i+1)*TAU/n;
      s = 0.5 + 0.5 * sin(u + v);
      glColor3f(1 - 0.85*s, 0.35 + 0.2*s, 0.2 + 0.8*s); // CORAL -> AZURE
      glVertex3f((R + r*cos(v))*cos(u), (R + r*cos(v))*sin(u), r*sin(v));
    }
  glEnd();
}
