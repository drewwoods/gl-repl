// @cfg grid = GRID_THEME_PLANES
// @cfg view_mode = RENDER3D_VIEW_2D
static float s; // palette mix in [0,1]

// --- Functions ----------------------
polygon(radius, sides, phase) {
  glBegin(GL_TRIANGLE_FAN);
    glNormal3f(0, 0, 1);
    glColor3f(0.92, 0.95, 0.98);
    glVertex3f(0, 0, 0);
    for(i, 0, sides + 1) {
      s = sin(i*TAU/sides + phase)*0.5 + 0.5;
      glColor3f(1 - 0.85*s, 0.35 + 0.2*s, 0.2 + 0.8*s); // CORAL -> AZURE
      glVertex3f(cos(i*TAU/sides + phase)*radius, sin(i*TAU/sides + phase)*radius, 0);
    }
  glEnd();
}
display() {
glTranslatef(0.0000f, 0.0000f, -4.0000f);   // @camera dist
glRotatef(0.0000f, 1.0f, 0.0f, 0.0f);   // @camera rx
glRotatef(0.0000f, 0.0f, 1.0f, 0.0f);   // @camera ry
glTranslatef(-0.0000f, -0.0000f, -0.0000f);   // @camera pan

// --- Render State -------------------
glClearColor(0.05, 0.06, 0.08, 1);
glClear(GL_COLOR_BUFFER_BIT | GL_DEPTH_BUFFER_BIT);
glEnable(GL_DEPTH_TEST);
glEnable(GL_NORMALIZE);

// --- Scene Geometry -----------------
glPushMatrix();
  glTranslatef(-2.4, 0, 0);
  polygon(0.9, 3, t*0.4);
glPopMatrix();
glPushMatrix();
  polygon(0.9, 6, -t*0.25);
glPopMatrix();
glPushMatrix();
  glTranslatef(2.4, 0, 0);
  polygon(0.9, 10, t*0.15);
glPopMatrix();
}
