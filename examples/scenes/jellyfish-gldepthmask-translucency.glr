// @cfg grid = GRID_THEME_OFF
// @cfg vertex_labels = OVERLAY_VERTEX_LABEL_OFF
// @cfg vertex_points = 0
// @cfg vertex_outlines = 0
static float pulse, bellR, bellH; // breath phase; bell radius/height pulse in opposition
static float ang, rad, topY; // frill scratch: segment angle, rim radius, rim height (tentacle() hangs off topY)
static float sway; // rim/tentacle sway -- read both at top level (frill) and inside tentacle()
static float glow; // -0.25..1.25 sweep: a bioluminescent pulse travelling crown -> rim
static float segs = 36; // bell azimuth segments
static float rings = 9; // bell latitude strips
static float ribs = 8; // radial canals drawn on the bell
static float tentacles = 15; // @tune
static float tentLen = 2.4; // @tune
static float marineSnow = 110; // @tune

// caustic light shafts falling from the surface, each with its own width,
// drift and slow flicker. One strip draws two quads -- left edge, bright
// centre, right edge -- so the shaft fades out sideways as well as downward
// and never shows a hard rectangular border. Pinned well behind the animal
// (z = -3.4) and drawn first, so everything else glows in front of them.
shafts(n, top, bot) {
  float x0, w, br, ph, fan;
  for(i, 0, n) {
    ph = rand(i, 2)*TAU;
    x0 = 5.5*rand2(i, 0) + 0.35*sin(t*0.17 + ph);
    w = 0.20 + 0.40*rand(i, 1);
    br = 0.05 + 0.04*sin(t*0.5 + ph);
    fan = 2.6*w;
    glBegin(GL_TRIANGLE_STRIP);
      glColor4f(0.3, 0.62, 0.92, 0);
      glVertex3f(x0 - w, top, -3.4);
      glVertex3f(x0 - fan + 0.7, bot, -3.4);
      glColor4f(0.34, 0.66, 0.95, br);
      glVertex3f(x0, top, -3.4);
      glColor4f(0.14, 0.4, 0.7, 0);
      glVertex3f(x0 + 0.7, bot, -3.4);
      glColor4f(0.3, 0.62, 0.92, 0);
      glVertex3f(x0 + w, top, -3.4);
      glVertex3f(x0 + fan + 0.7, bot, -3.4);
    glEnd();
  }
}

// one marine-snow layer: motes rise at their own speed and rem() wraps them
// back to the bottom, so the field loops forever with no stored state. Called
// twice at different point sizes -- a far dim layer and a near bright one --
// which is what gives the water column its parallax. `seed` offsets the rand
// iteration so the two layers are not the same field twice.
snowLayer(n, spread, speed, seed, br) {
  for(p, 0, n) {
    glColor4f(0.55, 0.75, 0.95, br*(0.30 + 0.70*rand(p, seed + 4)));
    glVertex3f(spread*rand2(p, seed) + 0.2*sin(t*0.4 + p), rem(3.2*rand2(p, seed + 1) + t*speed*(0.4 + rand(p, seed + 3)), 6.4), spread*rand2(p, seed + 2));
  }
}

// soft bloom disc behind the bell: a fan that is bright at the centre and
// vanishes at the rim, so the animal sits inside its own light. The camera
// barely rotates in this scene, so a fan in the xy plane reads as camera-facing
// without any billboard math.
halo(r, y) {
  float a;
  glBegin(GL_TRIANGLE_FAN);
    glColor4f(0.22, 0.58, 0.95, 0.15 + 0.05*pulse);
    glVertex3f(0, y, -0.35);
    glColor4f(0.08, 0.3, 0.7, 0);
    for(j, 0, 19) {
      a = j*TAU/18;
      glVertex3f(r*cos(a), y + r*0.78*sin(a), -0.35);
    }
  glEnd();
}

// bell: latitude strips from crown to just past the equator (it curls
// under). Everything except the alpha ripple depends only on the latitude
// index i, so the whole ring -- geometry AND color -- is hoisted out of the
// segment loop into function-scoped locals. u0/u1 are the two rows'
// normalized latitudes, computed once instead of eight times per vertex pair,
// and ca/sa are the segment direction shared by both rows. The color ramp runs
// deep indigo at the crown to cyan at the rim, and `band` adds a brighter
// Fresnel-ish belt just above the rim where a real bell thickens.
bellStrips(segs, rings, r, h) {
  float phi0, phi1, radT, radB, yT, yB;
  float u0, u1, a, ca, sa, band;
  float rT, gT, bT, aT;
  float rB, gB, bB, aB;
  for(i, 0, rings) {
    u0 = i/rings;
    u1 = (i + 1)/rings;
    phi0 = u0*PI*0.52;
    phi1 = u1*PI*0.52;
    radT = r*sin(phi0);
    yT = h*cos(phi0);
    radB = r*sin(phi1);
    yB = h*cos(phi1);
    band = smoothstep(0.55, 0.95, u0);
    rT = 0.14 + 0.24*u0;
    gT = 0.26 + 0.62*u0;
    bT = 0.72 + 0.28*u0;
    aT = 0.03 + 0.13*u0*u0 + 0.09*band;
    band = smoothstep(0.55, 0.95, u1);
    rB = 0.14 + 0.24*u1;
    gB = 0.26 + 0.62*u1;
    bB = 0.72 + 0.28*u1;
    aB = 0.03 + 0.13*u1*u1 + 0.09*band;
    glBegin(GL_TRIANGLE_STRIP);
      for(j, 0, segs+1) {
        a = j*TAU/segs;
        ca = cos(a);
        sa = sin(a);
        glColor4f(rT, gT, bT, aT + 0.04*sin(a*6 - t*2));
        glVertex3f(radT*ca, yT, radT*sa);
        glColor4f(rB, gB, bB, aB + 0.04*sin(a*6 - t*2));
        glVertex3f(radB*ca, yB, radB*sa);
      }
    glEnd();
  }
}

// radial canals: line strips running crown -> rim just outside the bell skin,
// with a bright bioluminescent pulse travelling down them (`glow`). The pulse
// overshoots the dome at both ends -- `glow` sweeps -0.25..1.25 while a canal
// spans 0..1 -- so it is already out of range when it wraps, and `fade` dims
// it over the last stretch. Between them the pulse eases in at the crown and
// dissolves past the rim instead of cutting off. `fade` depends only on
// `glow`, which is constant for the frame, so it is computed once here rather
// than per vertex.
// The latitude profile is identical for every canal, so the caller bakes it
// into scratch arrays A (radius) and B (height) once and each rib only pays
// for its own azimuth -- 11 sin/cos pairs instead of ribs*11.
bellRibs(ribs, r, h) {
  float a, ca, sa, k, fade;
  fade = smoothstep(1.25, 0.70, glow);
  for(n, 0, ribs) {
    a = n*TAU/ribs + 0.12;
    ca = cos(a)*r*1.015;
    sa = sin(a)*r*1.015;
    glBegin(GL_LINE_STRIP);
      for(i, 0, 11) {
        k = fade*smoothstep(0.22, 0, abs(i/10 - glow));
        glColor4f(0.35 + 0.60*k, 0.85 + 0.15*k, 1, 0.12 + 0.60*k);
        glVertex3f(A[i]*ca, B[i]*h*1.015, A[i]*sa);
      }
    glEnd();
  }
}

// the rim itself: a bright closed loop tracing the bell edge, scalloped on the
// same phase as the frill below it so the two read as one lip.
rimRing(segs, r, y) {
  float a;
  glBegin(GL_LINE_LOOP);
    for(j, 0, segs) {
      a = j*TAU/segs;
      glColor4f(0.50, 0.92, 1, 0.12 + 0.20*sin(a*9 + t*2.6));
      glVertex3f(r*cos(a), y, r*sin(a));
    }
  glEnd();
}

// four gonads slung under the crown: warm horseshoe ribbons, inner edge solid
// and outer edge fading out. They are the payoff of the whole technique -- the
// bell never occludes them because depth writes are off, so you read them
// *through* the translucent dome exactly as you would in an aquarium.
gonads(n, r, y) {
  float a0, a, ca, sa, u, ri, ro;
  ri = r*0.34;
  ro = r*0.64;
  for(k, 0, n) {
    a0 = k*TAU/n + t*0.06;
    glBegin(GL_TRIANGLE_STRIP);
      for(i, 0, 9) {
        u = i/8;
        a = a0 + (u - 0.5)*1.15;
        ca = cos(a);
        sa = sin(a);
        glColor4f(1, 0.32, 0.58, 0.44*sin(u*PI));
        glVertex3f(ri*ca, y, ri*sa);
        glColor4f(1, 0.58, 0.82, 0.05*sin(u*PI));
        glVertex3f(ro*ca, y - 0.30, ro*sa);
      }
    glEnd();
  }
}

// one tentacle: a swaying line strip; alpha fades toward the tip and the
// pulse tugs the strand upward (the drop*drop term makes tips lag the bell).
// The alpha also beads along the strand -- the sin(drop*22 - t*3) term -- so
// the nematocyst knots of a real tentacle drift down it as it moves.
tentacle(angAt, attach, len, phase, amp, cr, cg, cb) {
  float ax, az, drop;
  ax = cos(angAt)*attach;
  az = sin(angAt)*attach;
  glBegin(GL_LINE_STRIP);
    for(s, 0, 16) {
      drop = s/15;
      sway = amp*(sin(t*1.4 + phase + drop*3.5) + 0.4*sin(t*2.3 + phase*1.7 + drop*6))*drop;
      glColor4f(cr, cg, cb, 0.04 + 0.36*(1 - drop)*(1 - drop) + 0.16*(1 - drop)*sin(drop*22 - t*3));
      glVertex3f(ax*(1 + 0.2*drop) + sway, topY - drop*len + 0.15*pulse*drop*drop, az*(1 + 0.2*drop) + sway*0.55);
    }
  glEnd();
}

// one oral arm: a ruffled ribbon rather than a strand, so the four of them
// give the animal some mass under the bell. Width is carried on the horizontal
// perpendicular of the arm's own bearing (px/pz), tapers toward the tip, and
// frills with a travelling wave; the outer edge is transparent, which is what
// makes the ribbon look like it has a folded, gauzy face.
oralArm(angAt, len, phase, amp) {
  float ax, az, px, pz, drop, w, sw;
  float x, z, aa, hi;
  ax = cos(angAt)*bellR*0.34;
  az = sin(angAt)*bellR*0.34;
  px = -sin(angAt);
  pz = cos(angAt);
  glBegin(GL_TRIANGLE_STRIP);
    for(s, 0, 13) {
      drop = s/12;
      sw = amp*(sin(t*1.2 + phase + drop*3) + 0.4*sin(t*2.1 + phase*1.6 + drop*5.5))*drop;
      w = (0.11 + 0.07*sin(drop*13 + t*3))*(1 - 0.65*drop);
      x = ax*(1 + 0.9*drop) + sw;
      z = az*(1 + 0.9*drop) + sw*0.5;
      aa = 0.02 + 0.30*(1 - drop)*(1 - drop);
      hi = 0.55 + 0.45*sin(drop*13 + t*3);
      glColor4f(1, 0.28 + 0.30*hi, 0.52 + 0.34*hi, aa*(0.6 + 0.6*hi));
      glVertex3f(x - px*w, topY - drop*len + 0.2*pulse*drop*drop, z - pz*w);
      glColor4f(1, 0.66, 0.88, aa*0.12);
      glVertex3f(x + px*w, topY - drop*len + 0.2*pulse*drop*drop, z + pz*w);
    }
  glEnd();
}
display() {
  glTranslatef(0.0000f, 0.0000f, -7.2000f);   // @camera dist
  glRotatef(4.0000f, 1.0f, 0.0f, 0.0f);   // @camera rx
  glRotatef(0.0000f, 0.0f, 1.0f, 0.0f);   // @camera ry
  glTranslatef(0.0000f, 0.7000f, 0.0000f);   // @camera pan

  // Everything glows: additive blend with depth WRITES off (reads stay on).
  // glDepthMask(GL_FALSE) is the classic translucency trick - without it the
  // bell's far side would z-fight its near side, the tentacles would punch
  // holes through the bell, and the gonads inside it would vanish entirely.
  glClearColor(0.015, 0.03, 0.07, 1);
  glClear(GL_COLOR_BUFFER_BIT | GL_DEPTH_BUFFER_BIT);

  glDisable(GL_LIGHTING);
  glEnable(GL_DEPTH_TEST);
  glEnable(GL_BLEND);
  glBlendFunc(GL_SRC_ALPHA, GL_ONE);
  glEnable(GL_LINE_SMOOTH);
  glEnable(GL_POINT_SMOOTH);
  glDepthMask(GL_FALSE);
  pulse = sin(t*1.6);
  bellR = 1.5*(1 + 0.10*pulse);
  bellH = 1.1*(1 - 0.14*pulse);
  glow = fmod(t*0.32, 1.5) - 0.25; // fmod, not rem -- rem() folds to [-0.75, 0.75)

  // water column, back to front: light shafts, then two marine-snow layers.
  shafts(11, 4.6, -3.6);
  glPointSize(4);
  glBegin(GL_POINTS);
    snowLayer(marineSnow, 5.2, 0.28, 0, 0.16);
  glEnd();
  glPointSize(6);
  glBegin(GL_POINTS);
    snowLayer(marineSnow*0.5, 4.2, 0.45, 8, 0.24);
  glEnd();

  // gentle bob + tilt for the whole animal
  glTranslatef(0.2*sin(t*0.4), 0.18*sin(t*0.5), 0);
  glRotatef(8*sin(t*0.23), 0, 0, 1);
  halo(2.9*bellR, bellH*0.25);
  // segs/rings shadow the globals of the same name on purpose: the func takes
  // what it needs as arguments, so it reads without looking outward.
  bellStrips(segs, rings, bellR, bellH);

  // bake the shared latitude profile the canals ride on: A = sin(phi),
  // B = cos(phi) for the same 11 samples every rib walks.
  for(i, 0, 11) {
    A[i] = sin(i*PI*0.052);
    B[i] = cos(i*PI*0.052);
  }
  glLineWidth(1.4);
  bellRibs(ribs, bellR, bellH);

  // rim geometry: the scalloped frill hanging off the edge, plus the bright
  // lip loop that sits on it.
  rad = bellR*sin(PI*0.52);
  topY = bellH*cos(PI*0.52);
  glBegin(GL_TRIANGLE_STRIP);
    for(j, 0, segs+1) {
      ang = j*TAU/segs;
      sway = -0.18 - 0.10*pulse + 0.10*sin(ang*9 + t*2.6);
      glColor4f(0.42, 0.86, 1, 0.26);
      glVertex3f(rad*cos(ang), topY, rad*sin(ang));
      glColor4f(0.42, 0.86, 1, 0.02);
      glVertex3f(rad*1.05*cos(ang), topY + sway, rad*1.05*sin(ang));
    }
  glEnd();
  glLineWidth(1.8);
  rimRing(segs, rad, topY);

  // organs read through the dome, then the trailing gear below it
  gonads(4, bellR, bellH*0.34);
  glLineWidth(1.5);
  for(k, 0, tentacles) {
    tentacle(k*TAU/tentacles + 0.2*rand2(k, 1), bellR*0.85, tentLen*(0.75 + 0.5*rand(k, 2)), rand(k, 3)*TAU, 0.3, 0.35, 0.78, 1.0);
  }
  for(k, 0, 4) {
    oralArm(k*TAU/4 + 0.4, tentLen*1.25, k*1.7, 0.62);
  }
  glLineWidth(1);

  // bioluminescent core: two stacked soft points, breathing with the bell
  glPointSize(34);
  glBegin(GL_POINTS);
    glColor4f(1, 0.55, 0.75, 0.24 + 0.08*pulse);
    glVertex3f(0, bellH*0.3, 0);
  glEnd();
  glPointSize(14);
  glBegin(GL_POINTS);
    glColor4f(1, 0.82, 0.92, 0.5);
    glVertex3f(0, bellH*0.32, 0);
  glEnd();

  // leave shared GL state the way we found it
  glDepthMask(GL_TRUE);
  glDisable(GL_BLEND);
}
