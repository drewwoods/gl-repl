// @cfg vertex_labels = OVERLAY_VERTEX_LABEL_OFF
// @cfg vertex_points = 0
// @cfg vertex_outlines = 0
// @cfg polygon_highlight = 0
static float n, p, q, ang, rr, x, y, z; // samples, winds, angle, ring radius, coords
static float s; // palette mix in [0,1]
display() {
  glTranslatef(0.0000f, 0.0000f, -9.0000f);   // @camera dist
  glRotatef(23.0000f, 1.0f, 0.0f, 0.0f);   // @camera rx
  glRotatef(52.0000f, 0.0f, 1.0f, 0.0f);   // @camera ry
  glTranslatef(-0.0000f, -0.0000f, -0.0000f);   // @camera pan

  // --- Render State -------------------
  glClearColor(0.05, 0.06, 0.08, 1);
  glClear(GL_COLOR_BUFFER_BIT | GL_DEPTH_BUFFER_BIT);
  glLineWidth(2);

  // --- Scene Geometry -----------------
  n = 400; // samples around the closed curve
  p = 2; // turns around the torus axis
  q = 3; // turns through the torus hole
  glBegin(GL_LINE_LOOP);
    for(i, 0, n) {
      ang = TAU * i/n;
      rr = 2.0 + cos(q*ang) * (0.8 + 0.4*sin(t)); // lobes breathe in and out
      x = rr * cos(p*ang);
      y = rr * sin(p*ang);
      z = sin(q*ang) + 0.4*sin(4*ang - t*1.5); // a ripple travels along the curve
      s = 0.5 + 0.5*sin(2.0*ang + t); // palette mix in [0,1], swept along the curve
      glColor3f(1 - 0.85*s, 0.35 + 0.2*s, 0.2 + 0.8*s); // CORAL -> AZURE
      glVertex3f(x, y, z);
    }
  glEnd();
}
