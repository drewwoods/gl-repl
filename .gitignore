recovery.c

# macOS app-bundle build products (regenerate via `make app`)
/gl-repl.app/
/packaging/macos/gl-repl.icns
/packaging/macos/gl-repl.iconset/

# Release staging artifacts (regenerate via `make release`)
/dist/
# Per-user release build plan (hosts/modes) — edit via `make release-config`.
/.release.ini

# Recorded videos (regenerate via scripts/record-video.sh) — large files
# stay out of the repo.
/docs/images/*.mp4
