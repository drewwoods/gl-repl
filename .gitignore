*.o
*.dSYM
__pycache__/
audio_state.ini
# ...but the repl_live_demo ships a default config (not runtime state).
!tools/repl_live_demo/repl_live_demo.ini
# The built-in example catalog is authored source, not runtime state.
!examples/catalog.ini
# repl_live_demo 'e' round-trip export artifacts (written to CWD).
*.roundtrip.c
gl-repl
output.c
output.ply
build/
# Vendored freeglut CMake build output (also matched by the bare build/ above;
# anchored here for clarity). build-osmesa/ is the FREEGLUT_OSMESA=1 variant's
# tree. The vendored *source* under third_party/freeglut/ is checked in; only
# its build*/ trees are generated.
third_party/freeglut/build*/
# gl4es + GLU wasm static libs and checkouts, fetched/built by
# scripts/web-deps.sh for the WEB=1 build.
third_party/web/
workspace/
bench_repl
